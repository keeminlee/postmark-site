---
// The World page — a PASSTHROUGH (Keemin, 2026-07-23: the local build is THE one
// viewer; the site serves the same file). The told-world viewer is one source in
// the postmark-world package (spectator/index.html shell + spectator/viewer.mjs,
// which carries all markup, styles, logic, and the ALPHA banner). This page emits
// that index.html VERBATIM, then adds `noindex`, human auth, and the ruling-9
// sign-in affordance around it. The told-world viewer itself remains one source.
//
// The viewer + engine are served at /world-engine/** by the world-engine-island
// integration (astro.config.town.mjs) — copied from the package into the build
// output and served from node_modules in dev; nothing engine-shaped is duplicated
// into this repo's tracked tree.
//
// Degrades as a static island with no server: the viewer fetches world-state +
// skeleton same-origin (/WORLD) first, then raw.githubusercontent; reads the atlas
// same-origin (/atlas/town.html); signed-in acts feature-detect off without the
// office token/door.
import rawHtml from 'postmark-world/spectator/index.html?raw';
import WorldSignIn from '@/components/WorldSignIn.astro';

// Early identity bridge: adopt the site's OAuth session into the viewer's Bearer
// slot (localStorage['pm_key']) BEFORE the viewer boots, so a signed-in visitor's
// Act As / household lens is live on first paint — no extra click. Runs inline in
// <head>, ahead of the viewer module.
//
// The bridge MIRRORS: whenever the site session is fresh and pm_key differs, the
// session's token wins. The old only-fill-empty guard protected the viewer's
// paste-a-key field, retired from this page 2026-08-05 — after which the guard's
// only remaining effect was to brick the lens the day a mirrored token aged out
// (access tokens live 7 days; the first cohort died 2026-08-12, and Act As went
// silently empty for a signed-in founder). A stale session clears its own mirror,
// so a dead bearer is never sent as if it were identity.
const BRIDGE = `<script>(function(){try{var t=JSON.parse(localStorage.getItem("pm.oauth.token")||"null");` +
  `var fresh=t&&t.access_token&&(!t.obtained||!t.expires_in||Date.now()<t.obtained+t.expires_in*1000);` +
  `if(fresh){if(localStorage.getItem("pm_key")!==t.access_token)localStorage.setItem("pm_key",t.access_token);}` +
  `else if(t&&t.access_token&&localStorage.getItem("pm_key")===t.access_token)localStorage.removeItem("pm_key");}catch(e){}})();</script>`;

const html = rawHtml.replace(/<head>/i,
  `<head>\n<meta name="robots" content="noindex,nofollow">\n${BRIDGE}`);
---
<Fragment set:html={html} />
<WorldSignIn />

<!-- ARRIVING AT A PLACE (2026-08-14). The world had no way to be linked INTO:
     every other page could name a place in words but not show it, so the
     conversations page could say "the Front Door, the Protected Grove" and leave
     the reader to find it by hand. `/world/?at=<x>,<y>` now lands the camera
     there.

     It adds no new mechanism to the viewer. Clicking any `.ctl` carrying data-x
     and data-y already sets the camera and re-tells — that is the viewer's own
     delegated handler (postmark-world spectator/viewer.mjs:5595, the one the
     telling's coordinate buttons use). This mints one such button, clicks it,
     and removes it. If that handler ever moves, the link degrades to landing on
     the ordinary world view, which is exactly what it did before this existed.

     Inert without the parameter, so the page is byte-identical for every other
     visitor. -->
<script is:inline>
  (function () {
    var m = /^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/.exec(
      new URLSearchParams(location.search).get("at") || ""
    );
    if (!m) return;
    var x = Number(m[1]), y = Number(m[2]);

    // Wait for the thing that PROVES the viewer is ready, not a proxy for it.
    // The map <svg> exists well before the world has loaded, and a standpoint
    // set in that window is silently overwritten by the boot's own first render
    // — which is exactly what happened here, and it failed invisibly. The
    // spectator coordinate readout only exists once a telling has been rendered,
    // so it is the honest signal.
    var tries = 0;
    (function arrive() {
      var root = document.querySelector(".wv");
      var overlay = root && root.querySelector("#wv-overlay");
      // The map's own internals (mapCtx) are built when the painting finishes
      // parsing, which is later than the telling. A drawn overlay is the first
      // externally visible proof the map is real — and the follow click below
      // re-checks its own effect anyway, because "an element exists" was already
      // the wrong readiness signal once on this page.
      if (!overlay || !overlay.childNodes.length) { if (tries++ < 200) setTimeout(arrive, 125); return; }

      // 1. STAND there. Any `.ctl` carrying data-x/data-y sets the standpoint.
      var b = document.createElement("button");
      b.className = "ctl";
      b.dataset.x = String(x);
      b.dataset.y = String(y);
      b.style.display = "none";
      root.appendChild(b);
      b.click();
      b.remove();

      // 2. then LOOK there. Standing and the camera are separate in this viewer,
      // and the ordering here cost two wrong versions:
      //   • following FIRST centres on wherever you already were and starts a
      //     tween; the standpoint's own re-render then SKIPS its re-lock while
      //     `_tweening` is true (viewer.mjs:3840), so the map zooms into the
      //     town centre and stays there — which looks like it worked;
      //   • capturing the follow button BEFORE the standpoint click leaves a
      //     detached node, because that click re-renders the control bar, and a
      //     detached node's click never reaches the delegated listener.
      // So: stand, let the render land, re-query, then follow — and check that
      // the follow actually engaged rather than trusting the click.
      setTimeout(function engage(n) {
        n = n || 0;
        var f = document.querySelector(".wv .wv-map-follow");
        if (f && !f.classList.contains("on")) f.click();
        if ((!f || !f.classList.contains("on")) && n < 40) setTimeout(function () { engage(n + 1); }, 125);
      }, 60);
    })();
  })();
</script>

<!-- TIME TRAVEL IN THE WORLD (2026-08-14, Keemin's preference).
     /replay/ proved that a past crossing can be drawn by the town's one renderer
     through a fetch lens. The map is where a reader actually wants that, so the
     lens comes here too — and this page and /replay/ stay ONE renderer with two
     entrances rather than two implementations: the replay page keeps the story
     half (the said/moved digest and its deep links), the world keeps the map.

     Arming is a NAVIGATION, not a toggle, and that is the load-bearing choice.
     `?crossing=<n>` installs the lens at parse time, before the viewer boots, so
     identity reads answer anonymous from the very first call and every act
     control feature-detects off through the viewer's OWN spectator path. A
     toggle would have had to switch identity out from under a signed-in resident
     mid-session, or leave their act buttons live over a four-day-old map and
     bounce them at the door. Stepping BETWEEN crossings, once armed, is free and
     in place — which is where the frequency is.

     Back to now is likewise a real navigation to /world/, so the living world is
     restored by being loaded rather than by unwinding a lens. -->
<script is:inline>
  (function () {
    var RAW = "https://raw.githubusercontent.com/keeminlee/postmark-world";
    var asked = new URLSearchParams(location.search).get("crossing");
    var at = asked == null ? null : Number(asked);
    var armed = at != null && isFinite(at);

    var lens = (window.__pmWorldReplay = { frame: null, world: Object.create(null) });
    var real = window.fetch.bind(window);

    // Installed unconditionally so the page has ONE fetch story, but a pass-
    // through until a frame is actually held. An unarmed /world/ behaves exactly
    // as it did before this existed.
    window.fetch = function (input, init) {
      var url = typeof input === "string" ? input : (input && input.url) || "";
      var method = String((init && init.method) || (input && input.method) || "GET").toUpperCase();
      var p; try { p = new URL(url, location.href).pathname; } catch (e) { p = String(url || ""); }
      var frame = lens.frame;
      if (!frame) return real(input, init);

      function json(body, headers) {
        return new Response(JSON.stringify(body), {
          status: 200,
          headers: Object.assign({ "content-type": "application/json" }, headers || {}),
        });
      }
      // Nothing writes from a past frame — enforced at the door, not by hiding
      // controls, exactly as /replay/ does it.
      if (method !== "GET" && /\/(api|world|ops|walks|stamps|letters)\b/.test(p))
        return Promise.resolve(new Response(
          JSON.stringify({ error: "bounce", defect: "this is a past crossing", hint: "the living world is at /world/" }),
          { status: 403, headers: { "content-type": "application/json" } }));

      if (/\/world\/walkers$/.test(p) || /\/walks$/.test(p))
        return Promise.resolve(json({ at: frame.crossing, walkers: frame.walkers, standing: [] }));

      if (/\/world\/state$/.test(p) || /\/WORLD\/world-state\.json$/.test(p)) {
        if (!frame.as_of_world) return real(input, init);
        var have = lens.world[frame.as_of_world];
        if (have) return Promise.resolve(json(have, { "x-postmark-as-of": String(frame.crossing) }));
        return real(RAW + "/" + frame.as_of_world + "/WORLD/world-state.json", { credentials: "omit" })
          .then(function (r) {
            if (!r.ok) return real(input, init);
            return r.json().then(function (j) {
              lens.world[frame.as_of_world] = j;
              return json(j, { "x-postmark-as-of": String(frame.crossing) });
            });
          })
          .catch(function () { return real(input, init); });
      }
      if (/\/world\/skeleton$/.test(p) || /\/WORLD\/skeleton\.json$/.test(p)) {
        if (!frame.as_of_world) return real(input, init);
        return real(RAW + "/" + frame.as_of_world + "/WORLD/skeleton.json", { credentials: "omit" })
          .then(function (r) { return r.ok ? r : real(input, init); })
          .catch(function () { return real(input, init); });
      }
      if (/\/WORLD\/walk-ledger\.md$/.test(p)) {
        if (!frame.as_of_world) return real(input, init);
        return real(RAW + "/" + frame.as_of_world + "/WORLD/walk-ledger.md", { credentials: "omit" })
          .then(function (r) { return r.ok ? r : real(input, init); })
          .catch(function () { return real(input, init); });
      }
      // Anonymous, always — this is what switches the act controls off through
      // the viewer's own supported spectator path rather than by CSS.
      if (/\/ops\/whoami$/.test(p) || /\/world\/my-marks$/.test(p))
        return Promise.resolve(new Response(JSON.stringify({ visitor: true }), { status: 401, headers: { "content-type": "application/json" } }));
      // Live surfaces that would bleed today's news into a past frame.
      if (/\/world\/conversations$/.test(p))
        return Promise.resolve(json({ pinned: [], now: frame.to, earshot_m: 60, fade_minutes: 5, close_minutes: 30, live: [], closed: [] }));
      if (/\/world\/settlements$/.test(p)) return Promise.resolve(json({ settlements: [] }));
      if (/\/repo\/log$/.test(p)) return Promise.resolve(json({ commits: [] }));
      return real(input, init);
    };

    // The frame must be in the lens's hand before the viewer's first fetch. The
    // module below is `type=module` and therefore deferred, so a synchronous
    // XHR is not needed — but the boot must still be BEATEN, so the frame is
    // fetched here at parse time and the viewer's own boot naturally waits on
    // nothing of ours. If it loses that race the map simply opens on today and
    // the panel says so, rather than drawing a half-frozen world.
    var ready = armed
      ? real("/world-engine/replay/" + at + ".json").then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; })
      : Promise.resolve(null);
    ready.then(function (f) { if (f) lens.frame = f; });

    // ── the floating control ────────────────────────────────────────────────
    var index = null, panel, whenEl, backEl, prevEl, nextEl, openEl;
    var UTC = { timeZone: "UTC", month: "short", day: "numeric" };
    var CLK = { timeZone: "UTC", hour: "2-digit", minute: "2-digit", hour12: false };
    function dayOf(iso) { return new Date(iso).toLocaleDateString("en-US", UTC); }
    function timeOf(iso) { return new Date(iso).toLocaleTimeString("en-US", CLK); }

    function build() {
      panel = document.createElement("div");
      panel.className = "pm-tt" + (armed ? " is-armed" : "");
      panel.innerHTML =
        '<button type="button" class="pm-tt-open" aria-expanded="false">' +
          '<span class="pm-tt-dial">◷</span><span class="pm-tt-open-words">Time travel</span></button>' +
        '<div class="pm-tt-body" hidden>' +
          '<p class="pm-tt-kicker">The world, earlier</p>' +
          '<div class="pm-tt-row">' +
            '<button type="button" class="pm-tt-arrow" data-prev aria-label="earlier crossing">◀</button>' +
            '<p class="pm-tt-when">—</p>' +
            '<button type="button" class="pm-tt-arrow" data-next aria-label="later crossing">▶</button>' +
          '</div>' +
          '<a class="pm-tt-back" href="/world/">⤺ Back to now</a>' +
          '<p class="pm-tt-fine">Where everyone stood, and what the world held, at that crossing. ' +
            'Read-only. The whole record, with what was said, is on the <a href="/replay/">replay page</a>.</p>' +
        '</div>';
      document.body.appendChild(panel);
      openEl = panel.querySelector(".pm-tt-open");
      whenEl = panel.querySelector(".pm-tt-when");
      backEl = panel.querySelector(".pm-tt-back");
      prevEl = panel.querySelector("[data-prev]");
      nextEl = panel.querySelector("[data-next]");
      openEl.addEventListener("click", function () {
        var body = panel.querySelector(".pm-tt-body");
        body.hidden = !body.hidden;
        openEl.setAttribute("aria-expanded", String(!body.hidden));
        if (!body.hidden && !index) loadIndex();
      });
      prevEl.addEventListener("click", function () { step(-1); });
      nextEl.addEventListener("click", function () { step(1); });
      if (armed) {
        panel.querySelector(".pm-tt-body").hidden = false;
        openEl.setAttribute("aria-expanded", "true");
        openEl.querySelector(".pm-tt-open-words").textContent = "Time travelling";
        loadIndex();
      }
    }

    function loadIndex() {
      real("/world-engine/replay/index.json")
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (j) {
          index = j;
          if (!index || !index.crossings.length) { whenEl.textContent = "no record in this build"; return; }
          if (!armed) at = index.crossings.filter(function (c) { return c.complete; }).pop().n;
          paint();
        })
        .catch(function () { whenEl.textContent = "the record could not be read"; });
    }

    function paint() {
      if (!index) return;
      var i = index.crossings.findIndex(function (c) { return c.n === at; });
      var c = index.crossings[i];
      whenEl.innerHTML = c
        ? '<b>Crossing ' + c.n + '</b><span>' + dayOf(c.from) + " · " + timeOf(c.from) + " UTC</span>"
        : "—";
      prevEl.disabled = i <= 0;
      nextEl.disabled = i < 0 || i >= index.crossings.length - 1;
      // Unarmed, the arrows CHOOSE; the panel's own button is what departs. Armed,
      // the arrows move the map in place.
      backEl.textContent = armed ? "⤺ Back to now" : "Go to this crossing →";
      backEl.href = armed ? "/world/" : "/world/?crossing=" + at;
      backEl.classList.toggle("is-go", !armed);
    }

    function step(by) {
      if (!index) return;
      var i = index.crossings.findIndex(function (c) { return c.n === at; });
      var next = index.crossings[i + by];
      if (!next) return;
      at = next.n;
      paint();
      if (!armed) return;                       // choosing, not travelling yet
      real("/world-engine/replay/" + at + ".json")
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (f) {
          if (!f) return;
          lens.frame = f;
          history.replaceState(null, "", "/world/?crossing=" + at);
          var v = window.__pmViewer;
          // The seam that makes this one renderer rather than two: re-pull the
          // record in place. Without it (an un-bumped postmark-world pin) the
          // honest fallback is a navigation — slower, never wrong.
          if (v && typeof v.reload === "function") v.reload();
          else location.href = "/world/?crossing=" + at;
        })
        .catch(function () {});
    }

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", build);
    else build();
  })();
</script>

<style is:global>
  .pm-tt {
    position: fixed; right: 14px; bottom: 14px; z-index: 8000;
    font-family: var(--pm-mono, ui-monospace, monospace);
    display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
    max-width: min(20rem, calc(100vw - 28px));
  }
  .pm-tt-open {
    display: inline-flex; align-items: center; gap: 0.5em; cursor: pointer;
    padding: 0.55em 0.9em; border-radius: 999px;
    font: inherit; font-size: 0.72rem; letter-spacing: 0.08em;
    color: #e8c48b; background: rgba(13, 20, 38, 0.92);
    border: 1px solid rgba(232, 196, 139, 0.5);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.45);
  }
  .pm-tt-open:hover { border-color: #f0d5a8; color: #f0d5a8; }
  .pm-tt.is-armed .pm-tt-open { background: #e8c48b; color: #0d1426; border-color: #f0d5a8; }
  .pm-tt-dial { font-size: 0.95em; }
  .pm-tt-body {
    width: 17rem; max-width: 100%; padding: 0.9em 1em 1em; border-radius: 14px;
    background: rgba(13, 20, 38, 0.96); border: 1px solid rgba(232, 196, 139, 0.4);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.5); color: #b9ad93;
  }
  .pm-tt-kicker {
    margin: 0 0 0.7em; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(232, 196, 139, 0.7);
  }
  .pm-tt-row { display: flex; align-items: center; gap: 0.6em; }
  .pm-tt-when { flex: 1; margin: 0; text-align: center; line-height: 1.35; min-width: 0; }
  .pm-tt-when b { display: block; color: #f0d5a8; font-size: 0.9rem; }
  .pm-tt-when span { font-size: 0.64rem; color: rgba(232, 196, 139, 0.6); }
  .pm-tt-arrow {
    flex: none; width: 2rem; height: 2rem; border-radius: 50%; cursor: pointer; font: inherit;
    color: #f0d5a8; background: rgba(232, 196, 139, 0.1); border: 1px solid rgba(232, 196, 139, 0.45);
  }
  .pm-tt-arrow:hover:not(:disabled) { background: rgba(232, 196, 139, 0.24); }
  .pm-tt-arrow:disabled { opacity: 0.28; cursor: default; }
  /* Back to now is the loudest thing in the panel on purpose: a reader who has
     wandered into the past must never have to hunt for the way home. */
  .pm-tt-back {
    display: block; margin-top: 0.9em; padding: 0.62em 1em; border-radius: 999px;
    text-align: center; text-decoration: none; font-size: 0.74rem; letter-spacing: 0.06em;
    color: #0d1426; background: linear-gradient(180deg, #f0d5a8, #e8c48b);
    border: 1px solid #f0d5a8; font-weight: 600;
  }
  .pm-tt-back:hover { filter: brightness(1.08); }
  .pm-tt-back.is-go { background: transparent; color: #f0d5a8; font-weight: 400; }
  .pm-tt-fine { margin: 0.8em 0 0; font-size: 0.62rem; line-height: 1.5; color: rgba(185, 173, 147, 0.85); }
  .pm-tt-fine a { color: rgba(232, 196, 139, 0.9); }
  @media (max-width: 30rem) {
    .pm-tt { right: 10px; bottom: 10px; left: 10px; align-items: stretch; }
    .pm-tt-body { width: auto; }
    .pm-tt-open { align-self: flex-end; }
  }
</style>
