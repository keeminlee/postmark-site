---
// The World page — a PASSTHROUGH (Keemin, 2026-07-23: the local build is THE one
// viewer; the site serves the same file). The told-world viewer is one source in
// the postmark-world package (spectator/index.html shell + spectator/viewer.mjs,
// which carries all markup, styles, logic, and the ALPHA banner). This page emits
// that index.html VERBATIM, then adds `noindex`, human auth, and the ruling-9
// sign-in affordance around it. The told-world viewer itself remains one source.
//
// The viewer + engine are served at /world-engine/** by the world-engine-island
// integration (astro.config.town.mjs) — copied from the package into the build
// output and served from node_modules in dev; nothing engine-shaped is duplicated
// into this repo's tracked tree.
//
// Degrades as a static island with no server: the viewer fetches world-state +
// skeleton same-origin (/WORLD) first, then raw.githubusercontent; reads the atlas
// same-origin (/atlas/town.html); signed-in acts feature-detect off without the
// office token/door.
import rawHtml from 'postmark-world/spectator/index.html?raw';
import WorldSignIn from '@/components/WorldSignIn.astro';

// Early identity bridge: adopt the site's OAuth session into the viewer's Bearer
// slot (localStorage['pm_key']) BEFORE the viewer boots, so a signed-in visitor's
// Act As / household lens is live on first paint — no extra click. Runs inline in
// <head>, ahead of the viewer module.
//
// The bridge MIRRORS: whenever the site session is fresh and pm_key differs, the
// session's token wins. The old only-fill-empty guard protected the viewer's
// paste-a-key field, retired from this page 2026-08-05 — after which the guard's
// only remaining effect was to brick the lens the day a mirrored token aged out
// (access tokens live 7 days; the first cohort died 2026-08-12, and Act As went
// silently empty for a signed-in founder). A stale session clears its own mirror,
// so a dead bearer is never sent as if it were identity.
const BRIDGE = `<script>(function(){try{var t=JSON.parse(localStorage.getItem("pm.oauth.token")||"null");` +
  `var fresh=t&&t.access_token&&(!t.obtained||!t.expires_in||Date.now()<t.obtained+t.expires_in*1000);` +
  `if(fresh){if(localStorage.getItem("pm_key")!==t.access_token)localStorage.setItem("pm_key",t.access_token);}` +
  `else if(t&&t.access_token&&localStorage.getItem("pm_key")===t.access_token)localStorage.removeItem("pm_key");}catch(e){}})();</script>`;

const html = rawHtml.replace(/<head>/i,
  `<head>\n<meta name="robots" content="noindex,nofollow">\n${BRIDGE}`);
---
<Fragment set:html={html} />
<WorldSignIn />
