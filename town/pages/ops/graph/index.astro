---
// /ops/graph/ — the window (world-graph plan, Stage E).
//
// The founder's own view of world.db: every node the store holds and every edge
// between them, with the six standing invariants' findings PAINTED ONTO the
// picture rather than listed beside it. The plan's line for why that matters:
// "the feature that makes it debugging rather than decoration — lint violations
// painted as red edges: the stale wheelhouse as a dangling red edge you see,
// hanging off the vessel."
//
// Everything here is drawn client-side from the office's `GET /world/graph`,
// which is keyless like the rest of the world's read tier. Nothing about the
// graph is baked at build: the store is rehydrated on its own clock and a page
// that shipped a snapshot would be showing yesterday's world with today's date
// on it. The As-Of bar at the top says which world you are looking at, every
// time, and asks `GET /world/store` whether that is still the sha main points
// at — the store's own freshness question, answered by the store's own door
// rather than guessed from a clock here.
//
// ON CYTOSCAPE. Imported as an npm dependency and bundled by Astro, the same
// lane every other library on this site takes (marked, js-yaml): no CDN, no
// vendored copy in the tracked tree, nothing to drift. §2.6 chose it for the
// standing page because layouts, pan, zoom and click-to-expand come free; Sigma
// remains the drop-in swap if a whole-world WebGL view is ever wanted.
//
// ON THE Y AXIS. The world's y runs SOUTH and Cytoscape's runs DOWN the screen,
// so the map view passes coordinates through unchanged and north comes out up.
// The office says so in the payload (`coordinates`) rather than leaving it to a
// comment only one side can read — the GEXF exporter has to flip the same
// numbers for Gephi, and one of the two viewers was always going to get it
// backwards without the contract written down.
//
// Internal surface: noindex, like every page under /ops/.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";

// The seven decided edge types (§2.6 / dial 5), in the order the chips show
// them: the two structural ones first (they are 70% of the graph), then the
// convergence hops, then the one that carries a live finding.
const EDGE_TYPES = [
  { type: "contains", line: "spatial containment" },
  { type: "describes", line: "a predicate and what it predicates" },
  { type: "instance-of", line: "a token and its type" },
  { type: "implements", line: "a mark and the machinery that keeps it true" },
  { type: "reads", line: "code and a world surface it reads" },
  { type: "imports", line: "one module and another" },
  { type: "stop-of", line: "a stop and the vessel whose timetable names it" },
];

// The tier lattice adopted at Stage 0 (dial 2): constitution → blue,
// sovereignty → green, market → yellow, draft → gray. Two of the four have no
// members in the store today, and the legend says so rather than quietly
// showing a colour nothing wears.
const TIERS = [
  { tier: "constitution", label: "constitution", swatch: "tier-constitution" },
  { tier: "sovereignty", label: "sovereignty", swatch: "tier-sovereignty" },
  { tier: "market", label: "market", swatch: "tier-market" },
  { tier: "draft", label: "draft / untiered", swatch: "tier-draft" },
];

const KINDS = [
  { kind: "mark", label: "marks", line: "the world's own records — coloured by tier" },
  { kind: "class", label: "classes", line: "predicate marks that carry law" },
  { kind: "code", label: "code", line: "modules in the office and the world" },
  { kind: "doctrine", label: "doctrine", line: "ENGINE.md sections" },
  { kind: "unknown", label: "unresolved", line: "the far end of a dangling edge" },
];

// THE LENSES (founder ruling, 2026-08-13). The graph-views hub's readings pour
// into this page as ways of LOOKING at the one graph, and its six-tab frame
// retires: a second page rendering a second picture of the same store was the
// thing the ruling refused. A lens repaints — it never filters, never rebuilds,
// and never adds a node the store does not hold.
//
// One at a time, like `layout`, because two paints cannot share a node.
const PAINTS = [
  { paint: "tier", label: "the tier lattice", line: "the standing lattice — how this page has always drawn" },
  { paint: "census", label: "the tier census", line: "which records ASSERT a standing, and who reads the assertion" },
  { paint: "law", label: "the record's law", line: "the constitution as written marks — the piecewise LOGOS, lighting up as clauses land" },
];

// The census populations. Ported from the graph-views hub's model: the walk
// reads the `tier:` field in exactly one case, and every other carrier is
// stating something nobody is listening to.
const CENSUS = [
  { cls: "read", label: "read", line: "the town's own constitution — the one case the walk reads the field" },
  { cls: "inert", label: "inert", line: "a standing asserted on disk that no reader has the authority to honour" },
  { cls: "clean", label: "clean", line: "no `tier:` on disk — standing left to the one walk, which is the law" },
  { cls: "unread", label: "unread", line: "this office sends no key list, so the question cannot be asked of this node" },
];
---
<PostmarkLayout
  title="The world graph — Postmark ops"
  description="The window on world.db: every node and edge in the world store, with the standing invariants' findings painted onto the graph."
  active=""
  noindex={true}
>
  <div class="opsgraph" data-graph>
    <p class="pm-kicker"><a href="/">Postmark</a> · <a href="/ops/">Ops</a> · The graph</p>

    <header class="og-head">
      <h1>The world graph</h1>
      <p class="tag">world.db as it stands · the standing invariants painted on</p>
    </header>

    <!-- THE AS-OF BAR. Which world this is, when it was folded, and whether it
         is still the one main points at. Filled by the island; the shell says
         "reading" so a slow office never looks like an empty world. -->
    <section class="og-asof" data-asof>
      <span class="og-asof-dot" data-asof-dot></span>
      <span class="og-asof-text" data-asof-text>reading the store…</span>
      <span class="og-counts" data-counts></span>
      <button type="button" class="og-reload" data-reload hidden>re-read</button>
    </section>

    <!-- THE CHIPS. Views first (the whole reason to come here), then the two
         taxonomies. Every chip is a filter over what is already loaded — no
         chip costs a round trip, because the whole store came in one. -->
    <div class="og-chips">
      <div class="og-chiprow">
        <span class="og-chiplabel">view</span>
        <button type="button" class="og-chip og-chip-view is-on" data-view="all">everything</button>
        <button type="button" class="og-chip og-chip-view" data-view="convergence">convergence</button>
        <button type="button" class="og-chip og-chip-view" data-view="findings">findings only</button>
        <span class="og-chipsep"></span>
        <span class="og-chiplabel">layout</span>
        <button type="button" class="og-chip og-chip-layout is-on" data-layout="web">web</button>
        <button type="button" class="og-chip og-chip-layout" data-layout="map">map</button>
      </div>

      <div class="og-chiprow">
        <span class="og-chiplabel">paint</span>
        {PAINTS.map((p) => (
          <button type="button" class={`og-chip og-chip-paint${p.paint === "tier" ? " is-on" : ""}`} data-paint={p.paint} title={p.line}>{p.label}</button>
        ))}
      </div>

      <div class="og-chiprow">
        <span class="og-chiplabel">kinds</span>
        {KINDS.map((k) => (
          <button type="button" class="og-chip og-chip-kind is-on" data-kind={k.kind} title={k.line}>
            <i class={`og-glyph og-glyph-${k.kind}`} aria-hidden="true"></i>{k.label}
          </button>
        ))}
      </div>

      <div class="og-chiprow">
        <span class="og-chiplabel">edges</span>
        {EDGE_TYPES.map((e) => (
          <button type="button" class="og-chip og-chip-edge is-on" data-edge={e.type} title={e.line}>{e.type}</button>
        ))}
      </div>
    </div>

    <div class="og-stage">
      <div class="og-canvas">
        <div class="og-cy" data-cy></div>

        <!-- the legend, over the canvas' bottom-left; the tier lattice is the
             half people actually need, so it goes first. The colour row is
             swapped by the paint lens — a legend still naming the tier lattice
             while the canvas is painted by census would be worse than none. -->
        <div class="og-legend">
          <div class="og-legend-row" data-legend="tier">
            {TIERS.map((t) => (
              <span class="og-legend-item"><i class={`og-swatch og-${t.swatch}`} aria-hidden="true"></i>{t.label}</span>
            ))}
          </div>
          <div class="og-legend-row" data-legend="census" hidden>
            {CENSUS.map((c) => (
              <span class="og-legend-item" title={c.line}><i class={`og-swatch og-cen-${c.cls}`} aria-hidden="true"></i>{c.label}</span>
            ))}
          </div>
          <div class="og-legend-row" data-legend="law" hidden>
            <span class="og-legend-item"><i class="og-swatch og-rec-law" aria-hidden="true"></i>a clause of the law</span>
            <span class="og-legend-item"><i class="og-swatch og-rec-mech" aria-hidden="true"></i>a clause naming machinery</span>
            <span class="og-legend-item"><i class="og-swatch og-rec-off" aria-hidden="true"></i>not the record</span>
          </div>
          <div class="og-legend-row">
            {KINDS.map((k) => (
              <span class="og-legend-item"><i class={`og-glyph og-glyph-${k.kind}`} aria-hidden="true"></i>{k.label}</span>
            ))}
            <span class="og-legend-item og-legend-red"><i class="og-swatch og-lint" aria-hidden="true"></i>a finding</span>
          </div>
        </div>

        <!-- THE CLAIM, on hover. A mark's body is the sentence its author wrote
             about the thing, and until the office shipped it this window could
             say a node's degree, its tier and its path but not what it SAYS.
             Positioned over the canvas from the node's rendered position; never
             a real tooltip, because a `title` cannot be read off a canvas. -->
        <div class="og-claim" data-claim hidden aria-hidden="true"></div>

        <p class="og-hint" data-hint>tap a node to light its neighbourhood — neighbours hidden by a filter come back with it. Tap the background to let go.</p>
      </div>

      <!-- THE FINDINGS PANEL. The six standing invariants, each with its verdict,
           its headline, and its own evidence heads. "Show" selects exactly the
           nodes and edges the finding is about — the panel and the paint are one
           list, so a finding can never highlight something it does not name. -->
      <aside class="og-panel">
        <div class="og-panel-head">
          <h2 data-panel-title>Findings</h2>
          <button type="button" class="og-panel-back" data-panel-back hidden>← findings</button>
        </div>

        <div data-findings class="og-findings">
          <p class="og-quiet">reading…</p>
        </div>

        <!-- THE LENS PANEL. The chosen lens' own reading, in the findings'
             place: the census' numbers, or the record's clauses. It is the same
             contract the findings panel holds itself to — the panel and the
             paint read one list, so a lens can never count something it does
             not light. -->
        <div data-lens class="og-lens" hidden></div>

        <!-- the inspector: what one node is, when you tap it -->
        <div data-inspector class="og-inspector" hidden></div>
      </aside>
    </div>
  </div>

  <script>
    import cytoscape from "cytoscape";
    import { officeBase } from "@/lib/auth.mjs";
    import {
      SERIALIZATION_MAP, censusClassOf, tierCensus, fieldCensus, isRecordNode, recordTree,
    } from "@/lib/world-lenses.mjs";

    const root = document.querySelector("[data-graph]");
    if (root) (function () {
      const OFFICE = officeBase();
      const $ = (s) => root.querySelector(s);
      const all = (s) => Array.prototype.slice.call(root.querySelectorAll(s));

      // ── the palette ───────────────────────────────────────────────────────
      // Read off the town's own tokens where one exists, hard-coded where the
      // graph needs a hue the town has never had to name (the tier lattice's
      // green and blue). Cytoscape draws to a canvas and cannot read a CSS
      // custom property, so these are the one place on the page where a colour
      // is written twice — kept together so the pair is obvious.
      const TIER = {
        constitution: "#5b86ff",   // blue — the town's own law
        sovereignty: "#3fbf87",    // green — a household's own ground
        market: "#e0b04a",         // yellow — what is traded
        draft: "#7b8494",          // gray — the sketchbooks
      };
      const KIND = {
        class: "#aa8fd8",          // --pm-stamp: law wears the stamp's violet
        code: "#4ec3d9",
        doctrine: "#f2e6cd",       // near --pm-paper: doctrine is the paper the law is written on. Deliberately NOT the town gold, which sat a few degrees off the market tier's yellow and made 8 doctrine sections indistinguishable from 400 market marks.
        unknown: "#5b6377",
      };
      const RED = "#ff5c52";       // a finding. The one colour that overrides every other.
      const SPAN_MODEL = 4000;     // the map's scale denominator (see layoutMap)

      // THE CENSUS PALETTE. Deliberately the tier lattice's own four hues, put
      // to a second use: blue for the one assertion the walk reads (the town's
      // constitution, which is what blue already means here), green for a record
      // that asserts nothing and leaves standing to the walk — the lawful shape,
      // and the same green sovereignty wears — amber for an assertion nobody
      // honours, gray for a node the question cannot be asked of. Reusing the
      // hues rather than inventing four more keeps one page from teaching two
      // colour languages.
      const CENSUS_PAINT = {
        read: "#5b86ff",
        inert: "#e0b04a",
        clean: "#3fbf87",
        unread: "#3d4557",
      };

      // THE RECORD'S PALETTE. A clause that asserts constitution wears the
      // town's own blue; a clause that asserts nothing — every one of which
      // turns out to name MACHINERY rather than law — wears the stamp's violet,
      // which is what a class already wears on this page. Everything outside
      // the record goes to the ground colour: still there, still tappable, no
      // longer competing with the thing being read.
      const RECORD_PAINT = { law: "#5b86ff", mechanic: "#aa8fd8", off: "#252d3f" };

      const HINT_DEFAULT = "tap a node to light its neighbourhood — neighbours hidden by a filter come back with it. Tap the background to let go.";
      const hint = (text) => { $("[data-hint]").textContent = text || HINT_DEFAULT; };

      const colourOf = (d) => (d.kind === "mark" ? (TIER[d.tier] ?? TIER.draft) : (KIND[d.kind] ?? KIND.unknown));

      // ── state ─────────────────────────────────────────────────────────────
      let cy = null;
      let payload = null;
      let focused = null;            // the node whose neighbourhood is lit
      const WORLD_POS = new Map();   // id -> where the world says it is (see mount)
      const on = {
        kinds: new Set(["mark", "class", "code", "doctrine", "unknown"]),
        edges: new Set(["contains", "describes", "instance-of", "implements", "reads", "imports", "stop-of"]),
        view: "all",
        layout: "web",
        paint: "tier",
      };
      // Which of the two panel homes the back button returns to. The inspector
      // is a detour from whichever was showing, never a third place to be lost
      // in.
      let panelHome = "findings";
      let census = null, fields = null, record = null;   // the lenses' readings, computed once at mount

      // ── boot ──────────────────────────────────────────────────────────────
      async function boot() {
        let health = null;
        const [graphRes, healthRes] = await Promise.allSettled([
          fetch(OFFICE + "/world/graph", { headers: { accept: "application/json" } }),
          fetch(OFFICE + "/world/store", { headers: { accept: "application/json" } }),
        ]);
        if (graphRes.status !== "fulfilled") return dead("the office isn't answering", "the window reads GET /world/graph — the door is keyless, so this is the office being down rather than a permission.");
        if (!graphRes.value.ok) {
          const b = await graphRes.value.json().catch(() => ({}));
          return dead(b.defect || `the office said ${graphRes.value.status}`, b.hint || "");
        }
        payload = await graphRes.value.json();
        if (healthRes.status === "fulfilled" && healthRes.value.ok) health = await healthRes.value.json().catch(() => null);

        paintAsOf(health);
        mount();
        paintFindings();
        $("[data-reload]").hidden = false;
      }

      function dead(defect, hint) {
        $("[data-asof-dot]").className = "og-asof-dot is-bad";
        $("[data-asof-text]").textContent = defect;
        $("[data-findings]").textContent = "";
        const p = document.createElement("p");
        p.className = "og-quiet";
        p.textContent = hint;
        $("[data-findings]").appendChild(p);
      }

      // ── the As-Of bar ─────────────────────────────────────────────────────
      // Three separate facts, never blended: WHICH sha the store was folded
      // from, WHEN it was folded, and whether that sha is still the one main
      // points at. The third is the store's own answer (GET /world/store), not
      // an inference from the second — a store folded a minute ago can already
      // be behind, and a store folded last week can still be current.
      function paintAsOf(health) {
        const a = payload.as_of || {};
        const sha = (a.world || "").slice(0, 12);
        const ago = sinceWords(a.hydrated_at);
        const mainSha = health && health.main && health.main.sha ? health.main.sha : null;
        const fresh = mainSha ? mainSha === a.world : null;

        const dot = $("[data-asof-dot]");
        const bits = [`world ${sha || "?"}`, `hydrated ${ago}`];
        if (a.hydration_status && a.hydration_status !== "OK") bits.push(`status ${a.hydration_status}`);
        if (fresh === true) { dot.className = "og-asof-dot is-fresh"; bits.push("this IS the sha main points at"); }
        else if (fresh === false) { dot.className = "og-asof-dot is-stale"; bits.push(`BEHIND main (${mainSha.slice(0, 12)}) — rehydrate to see the current world`); }
        else { dot.className = "og-asof-dot"; bits.push("freshness unknown — the office could not read main"); }
        $("[data-asof-text]").textContent = bits.join(" · ");
      }

      function sinceWords(iso) {
        const t = Date.parse(iso || "");
        if (!Number.isFinite(t)) return "at an unknown time";
        const mins = Math.round((Date.now() - t) / 60000);
        if (mins < 1) return "just now";
        if (mins < 60) return `${mins} min ago`;
        const hrs = Math.round(mins / 60);
        if (hrs < 48) return `${hrs} h ago`;
        return `${Math.round(hrs / 24)} days ago`;
      }

      function paintCounts() {
        const n = cy.nodes(":visible").length;
        const e = cy.edges(":visible").length;
        const total = payload.counts.nodes;
        const lit = cy.elements(".lint:visible").length;
        const of = n === total ? "" : ` of ${total}`;
        $("[data-counts]").textContent = `${n}${of} nodes · ${e} edges · ${lit} carrying a finding`;
      }

      // ── the graph ─────────────────────────────────────────────────────────
      function mount() {
        const els = payload.elements;
        // THE WORLD'S OWN COORDINATES, COPIED OUT FIRST. Cytoscape takes the
        // position objects it is handed and writes layout results back through
        // them, so after one `cose` run the payload no longer holds where the
        // marks ARE — it holds where the force layout put them. Read back for
        // the map view that is a town drawn at made-up coordinates, and read
        // back in the inspector it is a lie about a record. Copied by value,
        // once, before cytoscape ever sees them.
        for (const n of els.nodes) if (n.position) WORLD_POS.set(n.data.id, { x: n.position.x, y: n.position.y });
        // A label short enough to read beside the dot it belongs to. Code ids
        // carry their whole path (`code:world/tools/vessel.test.mjs`) and are
        // twice the length of anything else on the canvas; the file name is what
        // a reader is looking for and the full path is one row away in the
        // inspector. Marks keep household/slug, because on this graph the
        // household is half the identity.
        for (const n of els.nodes) {
          const id = n.data.id;
          n.data.short = n.data.kind === "code" ? id.replace(/^code:/, "").split("/").pop() : id;
        }
        // The lint class is put on at mount rather than restyled later: it is a
        // property of the element (the store said so), not a mode the page is in.
        //
        // The lens classes ride along for the same reason: which census
        // population a record is in, and whether it is a clause of the written
        // law, are facts ABOUT the node, not modes the page is in. What the
        // paint chips switch is which of them cytoscape is looking at — a
        // `paint-*` class added to every node, so the mode lives in one place
        // and a node never has to be re-classified when the lens changes.
        for (const n of els.nodes) {
          const cls = [];
          if (n.data.lints && n.data.lints.length) cls.push("lint");
          if (n.data.unresolved) cls.push("ghost");
          cls.push("cen-" + censusClassOf(n.data));
          if (isRecordNode(n.data)) cls.push("rec", n.data.tier === "constitution" ? "rec-law" : "rec-mechanic");
          n.classes = cls.join(" ");
        }
        for (const e of els.edges) e.classes = e.data.lints && e.data.lints.length ? "lint" : "";

        // The readings, taken once off the payload the page already has. Nothing
        // here asks the office a second question.
        const data = els.nodes.map((n) => n.data);
        census = tierCensus(data);
        fields = fieldCensus(data);
        record = recordTree(data);

        cy = cytoscape({
          container: $("[data-cy]"),
          elements: els,
          wheelSensitivity: 0.2,
          // 700 nodes is small enough to keep labels honest at zoom rather than
          // paying for a texture cache that blurs them.
          textureOnViewport: false,
          motionBlur: false,
          style: [
            {
              selector: "node",
              style: {
                "background-color": (n) => colourOf(n.data()),
                "border-width": 0,
                // sqrt-scaled by degree, for the reason world-gexf.mjs gives:
                // the spread is two orders of magnitude and linear sizing turns
                // the hubs into discs that cover the town.
                width: (n) => 8 + Math.sqrt(n.data("deg") || 0) * 4,
                height: (n) => 8 + Math.sqrt(n.data("deg") || 0) * 4,
                label: "",
                "font-size": 9,
                "font-family": "ui-monospace, Consolas, monospace",
                color: "#cfd8ea",
                "text-background-color": "#070b15",
                "text-background-opacity": 0.78,
                "text-background-padding": 2,
                "text-margin-y": -4,
                "text-valign": "top",
                "min-zoomed-font-size": 7,
                "transition-property": "opacity",
                "transition-duration": "120ms",
              },
            },
            { selector: 'node[kind = "class"]', style: { shape: "diamond" } },
            { selector: 'node[kind = "code"]', style: { shape: "round-rectangle" } },
            { selector: 'node[kind = "doctrine"]', style: { shape: "hexagon" } },
            {
              // the far end of a dangling edge: hollow, so it reads as an
              // absence rather than as a thing
              selector: "node.ghost",
              style: { "background-opacity": 0.08, "border-width": 1.5, "border-color": KIND.unknown, "border-style": "dashed" },
            },
            {
              selector: "edge",
              style: {
                width: (e) => (e.data("type") === "contains" ? 1.4 : 0.8),
                "line-color": "#33415e",
                "curve-style": "haystack",
                "haystack-radius": 0,
                opacity: 0.55,
              },
            },
            { selector: 'edge[type = "implements"], edge[type = "instance-of"], edge[type = "stop-of"]', style: { "line-color": "#4c5f8a", opacity: 0.8 } },
            // ── the lenses ────────────────────────────────────────────────
            // Cytoscape resolves a property to the LAST matching rule, so a
            // lens' rules sit here: after the kinds and the tier lattice they
            // override, and before the lint and focus rules, which must keep
            // winning over any lens. A node only matches these while it wears
            // the mode class, so switching the lens off restores the lattice
            // without touching a single element's own classes.
            { selector: "node.paint-census", style: { "background-color": CENSUS_PAINT.unread } },
            { selector: "node.paint-census.cen-clean", style: { "background-color": CENSUS_PAINT.clean } },
            { selector: "node.paint-census.cen-read", style: { "background-color": CENSUS_PAINT.read } },
            { selector: "node.paint-census.cen-inert", style: { "background-color": CENSUS_PAINT.inert } },
            { selector: "node.paint-law", style: { "background-color": RECORD_PAINT.off, opacity: 0.3 } },
            // The record is 64 nodes in a graph of 767, and most of them are
            // leaves — degree-sizing hides exactly the clauses this lens is
            // for, so under it a clause is drawn at a readable floor.
            {
              selector: "node.paint-law.rec",
              style: {
                "background-color": RECORD_PAINT.mechanic, opacity: 1,
                width: (n) => 13 + Math.sqrt(n.data("deg") || 0) * 4,
                height: (n) => 13 + Math.sqrt(n.data("deg") || 0) * 4,
              },
            },
            { selector: "node.paint-law.rec.rec-law", style: { "background-color": RECORD_PAINT.law } },
            // ── the whole point of the page ───────────────────────────────
            { selector: "node.lint", style: { "border-width": 3, "border-color": RED, "border-opacity": 1 } },
            { selector: "edge.lint", style: { "line-color": RED, width: 3, opacity: 1, "z-index": 20 } },
            // ── focus: a lit neighbourhood, everything else pushed back ────
            { selector: ".dim", style: { opacity: 0.07 } },
            { selector: ".lit", style: { opacity: 1, "z-index": 30 } },
            { selector: "node.lit", style: { label: "data(short)", "z-index": 40 } },
            { selector: "node.pick", style: { "border-width": 3, "border-color": "#f6dcae", label: "data(short)", "font-size": 11, "z-index": 50 } },
            { selector: "edge.lit", style: { width: 2, "line-color": "#8aa0cc", opacity: 0.95 } },
            // Red wins, always, and it has to be said LAST: cytoscape resolves a
            // property to the last matching rule, so the focus styles above were
            // repainting a finding's own edge in the neutral highlight colour —
            // the one element on the page that must never lose its colour.
            { selector: "edge.lint.lit", style: { "line-color": RED, width: 3.5, opacity: 1, "z-index": 45 } },
            { selector: ".off", style: { display: "none" } },
          ],
          layout: { name: "preset" },   // laid out properly by applyFilters below
        });

        cy.on("tap", "node", (ev) => focus(ev.target));
        cy.on("tap", (ev) => { if (ev.target === cy) blur(); });
        cy.on("mouseover", "node", (ev) => showClaim(ev.target));
        cy.on("mouseout", "node", hideClaim);
        // A pan or a zoom leaves the card floating over whatever is now under
        // it, which would attach a claim to the wrong node — the one failure
        // this feature must not have.
        cy.on("pan zoom", hideClaim);

        setPaint(on.paint);
        applyFilters({ relayout: true });
      }

      // ── filters ───────────────────────────────────────────────────────────
      // Everything stays MOUNTED and is hidden with display:none rather than
      // removed: a filter is a way of looking, not a different graph, and
      // click-to-expand has to be able to bring a hidden neighbour back without
      // asking the office for it again.
      function applyFilters({ relayout = false } = {}) {
        cy.batch(() => {
          cy.elements().removeClass("off");
          if (on.view === "findings") {
            cy.elements().not(".lint").addClass("off");
            // a red edge needs both its ends, or it is a red line into nothing
            cy.edges(".lint").connectedNodes().removeClass("off");
          } else {
            const kinds = on.view === "convergence" ? new Set(payload.convergence_kinds) : on.kinds;
            cy.nodes().forEach((n) => { if (!kinds.has(n.data("kind"))) n.addClass("off"); });
            cy.edges().forEach((e) => { if (!on.edges.has(e.data("type"))) e.addClass("off"); });
          }
        });
        if (focused) focus(focused, { keep: true });
        if (relayout) runLayout();
        paintCounts();
      }

      function runLayout() {
        const eles = cy.elements(":visible");
        if (!eles.length) return;
        if (on.layout === "map") return layoutMap(eles);
        hint(null);
        // `cose` is the built-in force layout — no plugin, which matters for a
        // page that must build with nothing but the npm dependency. Capped at a
        // few hundred iterations: this is a debugging window, not a poster, and
        // the extra settling buys nothing a human reads.
        eles.layout({
          name: "cose",
          animate: false,
          numIter: 350,
          nodeRepulsion: 9000,
          idealEdgeLength: 60,
          gravity: 0.4,
          randomize: true,
          fit: true,
          padding: 30,
        }).run();
      }

      // THE MAP. Sited marks go where the world says they are — y unflipped, so
      // south is down and north is up. Everything else has no place in the world
      // (code, doctrine, classes, and the predicates that inherit their parent's
      // extent rather than sitting anywhere), and rather than pretend, they are
      // parked in a labelled column off to the west. Hiding them would be the
      // lie; scattering them across the town would be worse.
      function layoutMap(eles) {
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        eles.nodes().forEach((n) => {
          const p = positionOf(n);
          if (!p) return;
          minX = Math.min(minX, p.x); maxX = Math.max(maxX, p.x);
          minY = Math.min(minY, p.y); maxY = Math.max(maxY, p.y);
        });
        if (!Number.isFinite(minX)) return;   // nothing in view is anywhere; leave the web layout alone

        // A MAP HAS A SCALE. The world is 95 km across — Pando Peak is that far
        // from the quay — and a node is drawn in model units, so laying the
        // marks out at their metre coordinates and fitting the result renders
        // every one of them at a fraction of a pixel: an empty black rectangle
        // that is arithmetically correct and shows nothing. One uniform factor
        // takes metres into the model space, which is what the word "scale"
        // means on any map; every distance and every bearing survives it,
        // because it is the same number for both axes.
        const metres = Math.max(maxX - minX, maxY - minY, 1);
        const k = SPAN_MODEL / metres;
        const at = (p) => ({ x: (p.x - minX) * k, y: (p.y - minY) * k });

        let i = 0;
        const perCol = 40;
        const rowGap = SPAN_MODEL / perCol;
        cy.batch(() => {
          eles.nodes().forEach((n) => {
            const p = positionOf(n);
            if (p) { n.position(at(p)); return; }
            // THE NOWHERE COLUMN, west of the world's own bounding box. Code,
            // doctrine, classes and the predicates that inherit a parent's
            // extent are not ANYWHERE, and the map says so by putting them
            // outside it rather than scattering them through a town they have no
            // address in. Hiding them would be the tidier lie.
            const col = Math.floor(i / perCol);
            const row = i % perCol;
            i++;
            n.position({ x: -SPAN_MODEL * 0.22 - col * (SPAN_MODEL * 0.035), y: row * rowGap });
          });
        });
        cy.fit(eles, 40);
        hint(`the map, at ${Math.round(metres / 1000)} km across — the world's own coordinates, x east, y south. `
          + `The town is a speck beside Pando Peak; scroll to zoom in. Off to the west: everything that is not anywhere.`);
      }

      const positionOf = (n) => WORLD_POS.get(n.id()) ?? null;

      // ── the lenses ────────────────────────────────────────────────────────
      //
      // A LENS REPAINTS; IT NEVER FILTERS. Every node stays exactly where it is
      // and exactly as visible as the chips left it — what changes is which fact
      // about it the colour is carrying. That is the whole difference between
      // this and the six-tab hub it replaces: the hub drew a second picture of
      // the same store beside the first, and two pictures of one world drift.
      function setPaint(paint) {
        on.paint = paint;
        // A lens' own hint belongs to that lens. The map's belongs to the
        // layout and survives, because it is still true.
        if (on.layout !== "map") hint(null);
        all("[data-paint]").forEach((b) => b.classList.toggle("is-on", b.dataset.paint === paint));
        cy.batch(() => {
          cy.nodes().removeClass("paint-census paint-law");
          if (paint === "census") cy.nodes().addClass("paint-census");
          if (paint === "law") cy.nodes().addClass("paint-law");
        });
        all("[data-legend]").forEach((row) => { row.hidden = row.dataset.legend !== (paint === "tier" ? "tier" : paint); });
        panelHome = paint === "tier" ? "findings" : "lens";
        if (paint !== "tier") paintLens();
        showHome();
      }

      // THE CLAIM. What the mark SAYS, on hover — the sentence its author wrote,
      // capped at 150 characters by the world's own schema. Drawn as a card over
      // the canvas rather than as a `title`, because the graph is one canvas
      // element and a canvas has no children to hang a tooltip on.
      function showClaim(node) {
        const d = node.data();
        const card = $("[data-claim]");
        card.textContent = "";

        const id = document.createElement("b");
        id.textContent = d.id;
        card.appendChild(id);

        const line = document.createElement("span");
        if (d.body) line.textContent = d.body;                  // the author's own words: textContent, never innerHTML
        else if (d.kind === "mark") { line.textContent = "this store carries no body for this mark"; line.className = "is-quiet"; }
        else { line.textContent = d.kind + (d.subkind ? " · " + d.subkind : ""); line.className = "is-quiet"; }
        card.appendChild(line);

        // Placed from the node's RENDERED position (screen space, pan and zoom
        // already applied), flipped to the left of the node when it would run
        // off the right edge of the canvas.
        const p = node.renderedPosition();
        const box = $("[data-cy]").getBoundingClientRect();
        card.hidden = false;
        const w = card.offsetWidth;
        const left = p.x + 14 + w > box.width ? Math.max(4, p.x - 14 - w) : p.x + 14;
        card.style.left = left + "px";
        card.style.top = Math.max(4, Math.min(p.y - 10, box.height - card.offsetHeight - 4)) + "px";
      }
      const hideClaim = () => { $("[data-claim]").hidden = true; };

      // The lens' own reading, in the findings' place. Every number here is
      // computed from the payload the graph is drawn from, so the panel and the
      // paint cannot disagree.
      function paintLens() {
        const box = $("[data-lens]");
        box.textContent = "";
        if (on.paint === "census") paintCensusLens(box);
        if (on.paint === "law") paintLawLens(box);
      }

      // ── the census ────────────────────────────────────────────────────────
      // The tier field's populations, and then the whole field census run
      // through the serialization map. Ported from the graph-views hub, which
      // computed them in Node against a world clone; here they are a reading of
      // the store the office is serving right now, which is the point.
      function paintCensusLens(box) {
        box.appendChild(lede(
          "`tier:` is a DERIVED standing — decided by the one walk over the ground, not the author's to assert. "
          + "Every record still carrying the field is residue; the walk reads it in exactly one case, and this counts the rest."));

        if (!census.sent) {
          box.appendChild(warn(
            "this office does not send the author's key list, so the question cannot be asked of a single node. "
            + "The lens paints every mark UNREAD rather than reporting 0 carriers — which is the same number a finished cutover produces, and the opposite finding."));
          return;
        }

        const rows = [
          ["carries `tier:` on disk", census.carriers, census.marks, "the population the cutover has to empty"],
          ["· read — the town's own constitution", census.read, census.carriers, "the one case the walk reads the field (mark-standing § the one exception)"],
          ["· INERT — asserted, and nobody listening", census.inert, census.carriers, "a standing stated on disk that no reader has the authority to honour"],
          ["· · of those, invisible without this field", census.invisible_without_keys, census.inert, "an authored `tier: market` — the same word the loader supplies when nobody wrote one"],
          ["clean — standing left to the walk", census.clean, census.marks, "the lawful shape; the target for all of the above"],
        ];
        box.appendChild(numbers(rows));

        // A finding is a place to GO. "Show" lights exactly the records this
        // count is about, the same contract the findings panel holds.
        if (census.inert) box.appendChild(showButton("show the inert carriers", () => showIds(census.inert_ids, "grid")));

        box.appendChild(sectionHead("The serialization map — where every key on disk belongs"));
        box.appendChild(lede(
          `v${SERIALIZATION_MAP.version}, authored ${SERIALIZATION_MAP.authored}. A way station: the destination is ${SERIALIZATION_MAP.destination}. `
          + "RESIDUE and DEBT are kept apart because they are different failures — the map places residue nowhere on purpose, and debt is the map's own unfinished business."));
        box.appendChild(numbers([
          ["identity", fields.rows.identity, fields.total, "an identity atom — the class the tree speaks today"],
          ["an edge", fields.rows.edge, fields.total, "NOT a property: `by:` is the create-edge, `at:` is containment plus an offset"],
          ["a predicate's own payload", fields.rows.predicate, fields.total, "slot and value — the only keys on disk already in lawful shape"],
          ["a property → a predicate child", fields.rows.property, fields.total, "a genuine authored property, whose lawful form is a child node"],
          ["the action's log record", fields.rows.log, fields.total, "a fact about the act, not about the node"],
          ["TRUE RESIDUE — belongs nowhere", fields.rows.derived, fields.total, fields.residueKeys.map(([k, n]) => `${k} ×${n}`).join(", ") || "none"],
          ["MAPPING DEBT — the map places it nowhere YET", fields.rows.unmapped, fields.total,
            fields.unmappedKeys.length ? fields.unmappedKeys.map(([k, n]) => `${k} ×${n}`).join(", ") : "none — every key on disk has a stated destination"],
        ]));
        box.appendChild(quiet(`${fields.total} key instances read off ${fields.read} records; ${fields.placed} of them placed.`));
      }

      // ── the record's law ──────────────────────────────────────────────────
      // The piecewise LOGOS: the constitution written as real marks, each one a
      // clause whose body IS the sentence. NOTHING IS INVENTED — the subtree is
      // found by the path the store already carries, and a world where the
      // record has not been written yields an empty list that says so.
      function paintLawLens(box) {
        box.appendChild(lede(
          "The constitution as the world actually holds it: predicated marks under `let-there-be-light/the-record`, "
          + "each one a clause. This is the store's own record — clauses appear here as they land, and nothing on this page writes law."));

        if (!record.total) {
          box.appendChild(warn("this store holds no marks under the-record — either the clauses have not been written yet, or this office sends no `path` to find them by."));
          return;
        }

        box.appendChild(numbers([
          ["clauses in the record", record.total, payload.counts.by_kind.mark ?? null, ""],
          ["· asserting constitution", record.by_tier.constitution ?? 0, record.total, "a clause of the law itself"],
          ["· asserting nothing", record.total - (record.by_tier.constitution ?? 0), record.total, "every one of these names MACHINERY rather than law"],
          ["carrying their sentence", record.with_body, record.total, "a clause with no body is a heading, or an office that sends no bodies"],
        ]));
        box.appendChild(showButton("show the record as a tree", showRecord));

        const ul = document.createElement("ul");
        ul.className = "og-clauses";
        for (const c of record.clauses) {
          const li = document.createElement("li");
          li.className = "og-clause is-walkable" + (c.tier === "constitution" ? " is-law" : "");
          li.style.paddingLeft = (c.depth * 0.85) + "em";
          const b = document.createElement("b");
          b.textContent = c.id.replace(/^the-town\//, "");
          li.appendChild(b);
          if (c.body) {
            const s = document.createElement("span");
            s.textContent = c.body;                    // the clause's own words, never re-worded here
            li.appendChild(s);
          }
          li.addEventListener("click", () => walkTo(c.id));
          ul.appendChild(li);
        }
        box.appendChild(ul);
      }

      // The record laid out as what it is: ONE TREE, rooted at the-record. The
      // findings panel rejected `breadthfirst` for its own sets and was right
      // to — a finding is usually disconnected pairs, and breadthfirst strings
      // those into a strip four screens wide. The record is the opposite shape,
      // and a tree layout is the only one that shows a clause's depth.
      //
      // UNDIRECTED, and that is not a detail. A `describes` edge runs from the
      // predicate to the mark it predicates — child to PARENT — so a directed
      // breadthfirst walking out of the root reaches nothing and lays all 64
      // clauses in one flat row, which is the exact failure the findings panel
      // avoided by not using this layout at all. Undirected, the same edges give
      // the nesting depth back.
      function showRecord() {
        const ids = record.clauses.map((c) => c.id);
        const eles = showIds(ids, "none");
        if (!eles || !eles.length) return;
        const root = eles.nodes().filter((n) => n.id().endsWith("/the-record"));
        // RUN OVER THE EDGES TOO. `eles.nodes().layout(...)` hands breadthfirst a
        // collection with no edges in it, and a tree layout with no edges has no
        // tree: all 64 clauses come out in one flat row with the root stranded
        // below them. The edges are what make this layout the right one.
        eles.layout({
          name: "breadthfirst", animate: false, directed: false, spacingFactor: 1.35,
          roots: root.length ? root : undefined, fit: false,
        }).run();
        cy.fit(eles, 50);
        hint(`the record: ${record.total} clauses, deepest at ${Math.max(...record.clauses.map((c) => c.depth))} below the root. Hover a clause to read it.`);
      }

      // Light exactly a named set of ids and push everything else back — the
      // same contract `showFinding` holds, factored out so a lens cannot invent
      // a second, laxer version of it.
      function showIds(ids, layout = "grid") {
        const eles = cy.collection();
        for (const id of ids) {
          const el = cy.getElementById(id);
          if (el && el.length) eles.merge(el);
        }
        if (!eles.length) return null;
        // the edges among them, so a subtree reads as a tree rather than as dust
        eles.merge(eles.nodes().edgesWith(eles.nodes()));
        focused = null;
        cy.batch(() => {
          cy.elements().removeClass("lit dim pick");
          eles.removeClass("off");
          cy.elements().not(eles).addClass("dim");
          eles.addClass("lit");
        });
        if (layout === "grid") {
          const box = $("[data-cy]").getBoundingClientRect();
          const n = eles.nodes().length;
          const cols = Math.max(1, Math.ceil(Math.sqrt(n * Math.max(box.width / Math.max(box.height, 1), 0.2))));
          eles.nodes().layout({ name: "grid", animate: false, cols, avoidOverlap: true, condense: false, fit: false }).run();
          cy.fit(eles, 60);
        }
        paintCounts();
        return eles;
      }

      function walkTo(id) {
        const n = cy.getElementById(id);
        if (!n || !n.length) return;
        n.removeClass("off");
        focus(n);
        cy.animate({ center: { eles: n }, zoom: Math.max(cy.zoom(), 1.1) }, { duration: 200 });
      }

      // ── the lens panel's small parts ──────────────────────────────────────
      const sectionHead = (text) => { const h = document.createElement("h3"); h.className = "og-lens-head"; h.textContent = text; return h; };
      const lede = (text) => { const p = document.createElement("p"); p.className = "og-lens-lede"; p.textContent = text; return p; };
      const quiet = (text) => { const p = document.createElement("p"); p.className = "og-quiet"; p.textContent = text; return p; };
      const warn = (text) => { const p = document.createElement("p"); p.className = "og-lens-warn"; p.textContent = text; return p; };

      function showButton(label, fn) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "og-show";
        b.textContent = label;
        b.addEventListener("click", fn);
        return b;
      }

      // One row per number, with its denominator and its reason. The share bar
      // is drawn from the same two numbers the text states — never a third
      // figure a reader would have to trust separately.
      function numbers(rows) {
        const ul = document.createElement("ul");
        ul.className = "og-numbers";
        for (const [label, now, of, note] of rows) {
          const li = document.createElement("li");
          const l = document.createElement("b");
          l.textContent = label;
          const v = document.createElement("i");
          v.textContent = of ? `${now} / ${of}` : String(now);
          li.appendChild(l); li.appendChild(v);
          if (of) {
            const bar = document.createElement("div");
            bar.className = "og-bar";
            const fill = document.createElement("span");
            fill.style.width = Math.min(100, Math.round((now / of) * 100)) + "%";
            bar.appendChild(fill);
            li.appendChild(bar);
          }
          if (note) {
            const s = document.createElement("small");
            s.textContent = note;
            li.appendChild(s);
          }
          ul.appendChild(li);
        }
        return ul;
      }

      // ── focus: the neighbourhood, expanded ────────────────────────────────
      // Tapping a node reveals its closed neighbourhood EVEN WHERE A FILTER HAS
      // HIDDEN IT, and says how many it had to bring back. That is the honest
      // version of click-to-expand: the filter is still on, and the page tells
      // you it stepped outside it rather than silently widening what you asked
      // for.
      function focus(node, { keep = false } = {}) {
        focused = node;
        const hood = node.closedNeighborhood();
        const revealed = hood.filter(".off");
        cy.batch(() => {
          cy.elements().removeClass("lit dim pick");
          revealed.removeClass("off");
          cy.elements().not(hood).addClass("dim");
          hood.addClass("lit");
          node.addClass("pick");
        });
        if (!keep) inspect(node, revealed.nodes().length);
        paintCounts();
      }

      function blur() {
        focused = null;
        cy.batch(() => cy.elements().removeClass("lit dim pick"));
        applyFilters();
        hideClaim();
        showHome();
      }

      // ── the panel ─────────────────────────────────────────────────────────
      function paintFindings() {
        const box = $("[data-findings]");
        box.textContent = "";
        const lints = payload.lints || [];
        if (!lints.length) {
          const p = document.createElement("p");
          p.className = "og-quiet";
          p.textContent = "this store carries no lint findings — the hydration that wrote it ran without them.";
          box.appendChild(p);
          return;
        }
        for (const l of lints) {
          const card = document.createElement("article");
          card.className = "og-finding" + (l.verdict === "RED" ? " is-red" : "");

          const head = document.createElement("header");
          const pill = document.createElement("span");
          pill.className = "og-verdict v-" + String(l.verdict || "").toLowerCase().replace(/[^a-z]/g, "");
          pill.textContent = l.verdict;
          const id = document.createElement("b");
          id.textContent = l.lint;
          head.appendChild(pill);
          head.appendChild(id);
          card.appendChild(head);

          const h = document.createElement("p");
          h.className = "og-finding-head";
          h.textContent = l.headline;               // the lint's own words, never re-worded here
          card.appendChild(h);

          const im = l.implicates || { nodes: [], edges: [] };
          const meta = document.createElement("p");
          meta.className = "og-finding-meta";
          meta.textContent = im.paints === false
            ? (im.note || "nothing on the graph to point at")
            : `${im.nodes.length} node${im.nodes.length === 1 ? "" : "s"} · ${im.edges.length} edge${im.edges.length === 1 ? "" : "s"}`
              + (im.unmatched && im.unmatched.length ? ` · ${im.unmatched.length} named but NOT IN THE STORE` : "");
          card.appendChild(meta);

          if (im.note && im.paints !== false) {
            const note = document.createElement("p");
            note.className = "og-finding-note";
            note.textContent = im.note;
            card.appendChild(note);
          }

          if ((l.evidence || []).length) {
            const ul = document.createElement("ul");
            ul.className = "og-evidence";
            for (const line of l.evidence) {
              const li = document.createElement("li");
              li.textContent = line;                // resident/derived text: textContent, never innerHTML
              ul.appendChild(li);
            }
            card.appendChild(ul);
            if (l.evidence_total > l.evidence.length) {
              const more = document.createElement("p");
              more.className = "og-quiet";
              more.textContent = `+${l.evidence_total - l.evidence.length} more, and ${l.rows_total} rows behind them — npm run world:lints prints the lot`;
              card.appendChild(more);
            }
          }

          if (im.paints !== false && (im.nodes.length || im.edges.length)) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "og-show";
            btn.textContent = "show on the graph";
            btn.addEventListener("click", () => showFinding(l));
            card.appendChild(btn);
          }
          box.appendChild(card);
        }
      }

      // Selecting a finding lights EXACTLY the elements it named — the panel and
      // the paint read the same list, so a finding can never highlight something
      // it does not claim.
      function showFinding(l) {
        const im = l.implicates || { nodes: [], edges: [] };
        const ids = im.nodes.map((n) => n.id).concat(im.edges.map((e) => e.id));
        const eles = cy.collection();
        for (const id of ids) {
          const el = cy.getElementById(id);
          if (el && el.length) eles.merge(el);
        }
        if (!eles.length) return;
        focused = null;
        cy.batch(() => {
          cy.elements().removeClass("lit dim pick");
          eles.removeClass("off");
          // a red edge with a hidden end is a red line into nothing — bring the
          // ends back with it, whatever the current filter says
          eles.edges().connectedNodes().removeClass("off");
          cy.elements().not(eles).addClass("dim");
          eles.addClass("lit");
        });
        // Lay the lit set out on its own, in a grid shaped like the canvas.
        // Left where the whole-graph layout put them, a finding's nodes land
        // wherever they happened to fall and their labels overprint; a force
        // layout packs them into a column and does the same; `breadthfirst`
        // strings them into a strip four screens wide, because a finding is
        // usually a set of DISCONNECTED PAIRS (a mark and its mechanic, a parcel
        // and its class) rather than one tree — and a strip fits to a zoom where
        // every label disappears. A grid gives each node its own cell, which is
        // the property that matters when the point is to read the names. The
        // pairing stays visible: the red edges draw across it.
        const box = $("[data-cy]").getBoundingClientRect();
        const n = eles.nodes().length;
        const cols = Math.max(1, Math.ceil(Math.sqrt(n * Math.max(box.width / Math.max(box.height, 1), 0.2))));
        eles.nodes().layout({ name: "grid", animate: false, cols, avoidOverlap: true, condense: false, fit: false }).run();
        cy.fit(eles, 60);
        inspectFinding(l, im);
        paintCounts();
      }

      function inspectFinding(l, im) {
        const box = $("[data-inspector]");
        box.textContent = "";
        openDetour(`${l.lint} — what is lit`);

        const ul = document.createElement("ul");
        ul.className = "og-whylist";
        for (const n of im.nodes) ul.appendChild(whyRow(n.id, n.why, "node"));
        for (const e of im.edges) ul.appendChild(whyRow(e.id, e.why, "edge"));
        for (const u of im.unmatched || []) ul.appendChild(whyRow(u.id, "named by the lint, but the store has no node for it — the finding cannot be drawn", "missing"));
        box.appendChild(ul);
      }

      // A named node in a finding is a place to GO: L3 names 38 files, and the
      // question that follows reading that is always "which one, and what is it
      // attached to". Clicking the row walks there.
      function whyRow(id, why, kind) {
        const li = document.createElement("li");
        li.className = "og-why og-why-" + kind;
        const b = document.createElement("b");
        b.textContent = id;
        li.appendChild(b);
        if (why) {
          const s = document.createElement("span");
          s.textContent = why;
          li.appendChild(s);
        }
        if (kind === "node") {
          li.classList.add("is-walkable");
          li.addEventListener("click", () => {
            const n = cy.getElementById(id);
            if (!n || !n.length) return;
            n.removeClass("off");
            focus(n);
            cy.animate({ center: { eles: n }, zoom: Math.max(cy.zoom(), 1.1) }, { duration: 200 });
          });
        }
        return li;
      }

      // The inspector for one node: what the store holds about it, and every
      // edge it stands at either end of.
      function inspect(node, revealedCount) {
        const box = $("[data-inspector]");
        box.textContent = "";
        openDetour("This node");

        const d = node.data();
        const h = document.createElement("p");
        h.className = "og-inspect-id";
        h.textContent = d.id;
        box.appendChild(h);

        // WHAT IT SAYS, before what it is. A mark's body is the one finite
        // assertion the record is made of (the-record § the one claim), and a
        // reader who has to leave this page to find out what a node claims is
        // not reading the world through this window.
        if (d.body) {
          const claim = document.createElement("blockquote");
          claim.className = "og-inspect-claim";
          claim.textContent = d.body;              // the author's own words: textContent, never innerHTML
          box.appendChild(claim);
        }

        const facts = [
          ["kind", d.subkind ? `${d.kind} · ${d.subkind}` : d.kind],
          ["tier", d.tier || "—"],
          ["by", d.by || "—"],
          ["degree", `${d.deg} (${d.indeg} in · ${d.outdeg} out)`],
        ];
        const p = node.position();
        const orig = positionOf(node);
        if (orig) facts.push(["at", `${orig.x}, ${orig.y} m — x east, y south`]);
        else facts.push(["at", "nowhere in the world — this kind is not anywhere"]);
        if (d.path) facts.push(["path", d.path]);
        if (d.mechanic) facts.push(["mechanic", d.mechanic]);
        if (d.class) facts.push(["class", d.class]);
        if (d.affordances) facts.push(["affordances", String(d.affordances)]);
        // WHAT THE AUTHOR WROTE, beside what the loader composed. Every other
        // row here is the composed record; this is the file. It is the only
        // place on the page where "the author wrote `tier: market`" and "the
        // loader supplied it" are different sentences.
        if (Array.isArray(d.keys)) {
          const c = censusClassOf(d);
          facts.push(["`tier:`", {
            read: "written, and READ — the town's own constitution is the one case the walk reads the field",
            inert: "written, and INERT — no reader has the authority to honour this assertion",
            clean: "not written — standing is left to the one walk, which is the law",
            unread: "—",
          }[c]]);
          facts.push(["keys on disk", d.keys.join(", ")]);
        }
        if (d.unresolved) facts.push(["unresolved", "nothing in the store claims this id — it is the far end of a dangling edge, kept because the dangle IS the finding"]);

        const dl = document.createElement("dl");
        dl.className = "og-facts";
        for (const [k, v] of facts) {
          const dt = document.createElement("dt"); dt.textContent = k;
          const dd = document.createElement("dd"); dd.textContent = v;
          dl.appendChild(dt); dl.appendChild(dd);
        }
        box.appendChild(dl);

        if ((d.lints || []).length) {
          const red = document.createElement("p");
          red.className = "og-inspect-lint";
          red.textContent = `carries a finding: ${d.lints.join(", ")}`;
          box.appendChild(red);
        }

        const edges = node.connectedEdges();
        const head = document.createElement("p");
        head.className = "og-quiet";
        head.textContent = `${edges.length} edge${edges.length === 1 ? "" : "s"}`
          + (revealedCount ? ` · ${revealedCount} neighbour${revealedCount === 1 ? "" : "s"} brought back from behind the current filter` : "");
        box.appendChild(head);

        const ul = document.createElement("ul");
        ul.className = "og-edgelist";
        edges.forEach((e) => {
          const li = document.createElement("li");
          if (e.hasClass("lint")) li.className = "is-red";
          const dir = e.source().id() === node.id() ? "→" : "←";
          const other = e.source().id() === node.id() ? e.target().id() : e.source().id();
          const t = document.createElement("i"); t.textContent = e.data("type");
          li.appendChild(t);
          li.appendChild(document.createTextNode(` ${dir} ${other}`));
          li.addEventListener("click", () => {
            const n = e.source().id() === node.id() ? e.target() : e.source();
            n.removeClass("off");
            focus(n);
          });
          ul.appendChild(li);
        });
        box.appendChild(ul);
      }

      // THE PANEL HAS TWO HOMES AND ONE DETOUR. Which home depends on the lens:
      // under the tier lattice the panel is the findings, under a lens it is
      // that lens' reading. The inspector is the detour, and the back button
      // returns to whichever home you left — never to a third place.
      const HOME_TITLE = { findings: "Findings", census: "The tier census", law: "The record's law" };

      function showHome() {
        $("[data-inspector]").hidden = true;
        $("[data-findings]").hidden = panelHome !== "findings";
        $("[data-lens]").hidden = panelHome !== "lens";
        $("[data-panel-back]").hidden = true;
        $("[data-panel-title]").textContent = panelHome === "findings" ? HOME_TITLE.findings : HOME_TITLE[on.paint];
      }

      // The detour: hide both homes, show the inspector, and offer the way back.
      function openDetour(title) {
        $("[data-findings]").hidden = true;
        $("[data-lens]").hidden = true;
        $("[data-inspector]").hidden = false;
        $("[data-panel-back]").hidden = false;
        $("[data-panel-back]").textContent = "← " + (panelHome === "findings" ? "findings" : HOME_TITLE[on.paint].toLowerCase());
        $("[data-panel-title]").textContent = title;
      }

      // ── wiring ────────────────────────────────────────────────────────────
      all("[data-kind]").forEach((btn) => btn.addEventListener("click", () => {
        const k = btn.dataset.kind;
        if (on.kinds.has(k)) on.kinds.delete(k); else on.kinds.add(k);
        btn.classList.toggle("is-on", on.kinds.has(k));
        setView("all");
        applyFilters({ relayout: true });
      }));

      all("[data-edge]").forEach((btn) => btn.addEventListener("click", () => {
        const t = btn.dataset.edge;
        if (on.edges.has(t)) on.edges.delete(t); else on.edges.add(t);
        btn.classList.toggle("is-on", on.edges.has(t));
        applyFilters({ relayout: true });
      }));

      all("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
        setView(btn.dataset.view);
        applyFilters({ relayout: true });
      }));

      function setView(v) {
        on.view = v;
        all("[data-view]").forEach((b) => b.classList.toggle("is-on", b.dataset.view === v));
      }

      all("[data-layout]").forEach((btn) => btn.addEventListener("click", () => {
        on.layout = btn.dataset.layout;
        all("[data-layout]").forEach((b) => b.classList.toggle("is-on", b === btn));
        runLayout();
      }));

      // A lens repaints and re-panels; it never relayouts and never filters, so
      // choosing one leaves the graph you were reading exactly where it was.
      all("[data-paint]").forEach((btn) => btn.addEventListener("click", () => setPaint(btn.dataset.paint)));

      $("[data-panel-back]").addEventListener("click", () => { blur(); });
      $("[data-reload]").addEventListener("click", () => { location.reload(); });

      boot();
    })();
  </script>

  <style is:global>
