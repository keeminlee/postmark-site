    .pm .harbor .lede {
      max-width: 60ch; margin: 0.6em auto 0;
      color: #cdc2ab; font-size: 1rem; line-height: 1.65;
    }
    .pm .harbor .asof {
      margin: 1em 0 0;
      font-family: var(--pm-mono); font-size: 0.68rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(232, 196, 139, 0.62);
    }

    /* amber, because a stale instrument is not an error — it is a caveat.
       The error band is wax red: that one IS a failure to say out loud. */
    .pm .harbor .stale, .pm .harbor .errband {
      margin: 1.2em 0 0; padding: 0.7em 1em;
      border-radius: 9px;
      font-family: var(--pm-mono); font-size: 0.72rem; line-height: 1.55;
    }
    .pm .harbor .stale {
      border: 1px solid rgba(232, 178, 92, 0.5);
      background: rgba(232, 178, 92, 0.1);
      color: #f0cf94;
    }
    .pm .harbor .errband {
      border: 1px solid rgba(156, 63, 46, 0.6);
      background: rgba(156, 63, 46, 0.16);
      color: #f0b8ab;
    }
    .pm .harbor .stale[hidden], .pm .harbor .errband[hidden] { display: none; }

    .pm .harbor .sec-lede {
      max-width: 64ch; margin: 0 0 1.4em;
      color: #cdc2ab; font-size: 0.95rem; line-height: 1.65;
    }
    .pm .harbor .quiet {
      margin: 0; padding: 1.4em 0;
      font-family: var(--pm-mono); font-size: 0.78rem; line-height: 1.6;
      color: rgba(232, 196, 139, 0.55);
    }

    /* ── §1 the registry ── */
    .pm .harbor .reg {
      display: grid; gap: 1.3em;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
    .pm .harbor .town { padding: 1.3em 1.4em 1.4em; }
    /* the hub is a member, not a landlord: one brighter hairline, no second shape */
    .pm .harbor .town.is-hub {
      box-shadow:
        0 22px 70px rgba(0, 0, 0, 0.55),
        0 0 0 2px rgba(232, 196, 139, 0.5),
        0 0 80px rgba(232, 196, 139, 0.1);
    }
    .pm .harbor .town-head { display: flex; align-items: center; gap: 0.6em; margin: 0 0 0.7em; }
    .pm .harbor .town-glyph { font-size: 1.5rem; line-height: 1; flex: none; }
    .pm .harbor .town-head h3 {
      margin: 0; font-size: 1.2rem; color: var(--pm-ink);
      font-family: var(--pm-mono); letter-spacing: 0.02em;
    }
    .pm .harbor .hub-badge {
      margin-left: auto; flex: none;
      font-family: var(--pm-mono); font-size: 0.56rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--pm-accent);
      border: 1px solid rgba(164, 99, 42, 0.45); border-radius: 999px;
      padding: 3px 8px; line-height: 1;
    }
    .pm .harbor .town-body {
      margin: 0 0 1em; color: var(--pm-ink);
      font-size: 0.93rem; line-height: 1.6;
    }
    .pm .harbor .preds { margin: 0; padding-top: 0.9em; border-top: 1px dashed var(--pm-line); }
    .pm .harbor .pred { margin: 0 0 0.85em; }
    .pm .harbor .pred:last-child { margin-bottom: 0; }
    .pm .harbor .pred dt {
      font-family: var(--pm-mono); font-size: 0.58rem; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--pm-accent); margin: 0 0 0.2em;
    }
    .pm .harbor .pred dd { margin: 0; }
    .pm .harbor .pred-value {
      display: block; color: var(--pm-ink);
      font-family: var(--pm-mono); font-size: 0.76rem; line-height: 1.5;
      word-break: break-word;
    }
    .pm .harbor .pred-value a { color: var(--pm-accent); }
    .pm .harbor .pred-note {
      display: block; margin-top: 0.25em;
      color: var(--pm-ink-soft); font-size: 0.85rem; line-height: 1.55; font-style: italic;
    }

    /* ── §2 the water ── */
    .pm .harbor .ledger-head {
      display: flex; align-items: baseline; gap: 0.8em; flex-wrap: wrap;
      margin: 0 0 0.7em;
      font-family: var(--pm-mono); font-size: 0.62rem;
      letter-spacing: 0.16em; text-transform: uppercase;
    }
    .pm .harbor .ledger-title { color: var(--pm-gold); }
    .pm .harbor .ledger-count { color: rgba(232, 196, 139, 0.5); }
    .pm .harbor .ledger { list-style: none; margin: 0 0 1.6em; padding: 0; }
    .pm .harbor .carry {
      display: grid; gap: 0.15em 1em;
      grid-template-columns: 7.5em minmax(0, 1fr);
      padding: 0.75em 0.9em; margin: 0 0 0.5em;
      border-left: 2px solid rgba(232, 196, 139, 0.32);
      background: rgba(232, 196, 139, 0.04);
      border-radius: 0 8px 8px 0;
    }
    .pm .harbor .carry-date {
      grid-column: 1; grid-row: 1;
      font-family: var(--pm-mono); font-size: 0.68rem; letter-spacing: 0.06em;
      color: rgba(232, 196, 139, 0.6); white-space: nowrap;
    }
    .pm .harbor .carry-route {
      grid-column: 2; grid-row: 1;
      display: flex; align-items: center; gap: 0.5em; flex-wrap: wrap;
      font-family: var(--pm-mono); font-size: 0.76rem;
      color: var(--pm-gold-bright);
    }
    .pm .harbor .t-town { display: inline-flex; align-items: center; gap: 0.3em; }
    .pm .harbor .t-glyph { font-size: 0.95rem; }
    .pm .harbor .arrow { color: rgba(232, 196, 139, 0.55); }
    .pm .harbor .carry-what {
      grid-column: 2; grid-row: 2;
      color: #cdc2ab; font-size: 0.9rem; line-height: 1.55;
    }
    @media (max-width: 560px) {
      .pm .harbor .carry { grid-template-columns: 1fr; }
      .pm .harbor .carry-date,
      .pm .harbor .carry-route,
      .pm .harbor .carry-what { grid-column: 1; grid-row: auto; }
    }

    .pm .harbor .standing {
      margin: 0 0 0.6em; padding: 0.2em 0 0.2em 1.1em;
      border-left: 3px solid var(--pm-gold);
    }
    .pm .harbor .standing p {
      margin: 0; color: var(--pm-gold-bright);
      font-size: 1.05rem; line-height: 1.5; font-style: italic;
    }
    .pm .harbor .standing cite {
      display: block; margin-top: 0.4em;
      font-family: var(--pm-mono); font-size: 0.68rem; font-style: normal;
      color: rgba(232, 196, 139, 0.6);
    }

    /* ── §3 the foreign shores ── */
    .pm .harbor .shores { display: grid; gap: 1.4em; }
    .pm .harbor .shore { padding: 1.3em 1.4em 1.4em; }
    .pm .harbor .shore-head {
      display: flex; align-items: center; gap: 0.6em; flex-wrap: wrap;
      margin: 0 0 1em; padding-bottom: 0.85em;
      border-bottom: 1px dashed var(--pm-line);
    }
    .pm .harbor .shore-title { display: flex; align-items: baseline; gap: 0.6em; flex-wrap: wrap; }
    .pm .harbor .shore-title h3 {
      margin: 0; font-size: 1.25rem; color: var(--pm-ink);
      font-family: var(--pm-mono); letter-spacing: 0.02em;
    }
    .pm .harbor .shore-kind {
      font-family: var(--pm-mono); font-size: 0.62rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--pm-ink-soft);
    }
    .pm .harbor .shore-door {
      margin-left: auto;
      font-family: var(--pm-mono); font-size: 0.7rem;
      color: var(--pm-accent); text-decoration: none;
      border-bottom: 1px dashed rgba(164, 99, 42, 0.5);
    }
    .pm .harbor .shore-door:hover { color: var(--pm-wax); }
    .pm .harbor .shore-error {
      margin: 0; color: var(--pm-wax); font-weight: 700; font-size: 0.95rem;
    }
    .pm .harbor .shore-error-detail {
      margin: 0.3em 0 0; color: var(--pm-ink-soft);
      font-family: var(--pm-mono); font-size: 0.72rem; line-height: 1.5;
    }

    .pm .harbor .figs { display: flex; flex-wrap: wrap; gap: 1.6em 2.2em; margin: 0 0 0.4em; }
    .pm .harbor .fig { display: flex; flex-direction: column; gap: 0.1em; }
    .pm .harbor .fig-n {
      font-family: var(--pm-mono); font-size: 1.5rem; font-weight: 700; line-height: 1;
      color: var(--pm-wax);
    }
    .pm .harbor .fig-n.is-zero { color: var(--pm-ink-soft); font-weight: 400; }
    .pm .harbor .fig-l {
      font-family: var(--pm-mono); font-size: 0.6rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--pm-ink-soft);
    }

    .pm .harbor .block { margin: 1.5em 0 0; }
    .pm .harbor .block h4 {
      margin: 0 0 0.55em;
      font-family: var(--pm-mono); font-size: 0.62rem; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--pm-accent);
    }
    .pm .harbor .note {
      margin: 0.5em 0 0; color: var(--pm-ink-soft);
      font-size: 0.82rem; line-height: 1.55; font-style: italic;
    }
    .pm .harbor .chips { display: flex; flex-wrap: wrap; gap: 0.45em; }
    .pm .harbor .chip {
      font-family: var(--pm-mono); font-size: 0.68rem; line-height: 1;
      color: var(--pm-ink); background: rgba(164, 99, 42, 0.09);
      border: 1px solid rgba(164, 99, 42, 0.3); border-radius: 999px;
      padding: 5px 10px;
    }
    .pm .harbor .chip.law { color: var(--pm-accent); font-weight: 700; letter-spacing: 0.04em; }
    /* fresh · warn · alarm — quiet, amber, and the wax seal itself */
    .pm .harbor .chip.status {
      font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      font-size: 0.58rem; padding: 4px 9px;
    }
    .pm .harbor .chip.status.fresh { color: #3d6b4a; background: rgba(61, 107, 74, 0.1); border-color: rgba(61, 107, 74, 0.34); }
    .pm .harbor .chip.status.warn { color: #8a5a12; background: rgba(190, 138, 40, 0.14); border-color: rgba(190, 138, 40, 0.44); }
    .pm .harbor .chip.status.alarm { color: var(--pm-paper); background: var(--pm-wax); border-color: var(--pm-wax); }

    .pm .harbor .recent, .pm .harbor .cargo { list-style: none; margin: 0; padding: 0; }
    .pm .harbor .rec { padding: 0.6em 0; border-bottom: 1px dashed var(--pm-line); }
    .pm .harbor .rec:last-child { border-bottom: 0; padding-bottom: 0; }
    .pm .harbor .rec-meta {
      display: flex; align-items: baseline; gap: 0.6em; flex-wrap: wrap;
      font-family: var(--pm-mono); font-size: 0.66rem;
    }
    .pm .harbor .rec-kind {
      color: var(--pm-accent); text-transform: uppercase; letter-spacing: 0.12em;
      font-size: 0.56rem; font-weight: 700;
    }
    .pm .harbor .rec-who { color: var(--pm-wax); }
    .pm .harbor .rec-when { margin-left: auto; color: var(--pm-ink-soft); white-space: nowrap; }
    .pm .harbor .rec-what {
      margin: 0.3em 0 0; color: var(--pm-ink);
      font-size: 0.88rem; line-height: 1.55;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .pm .harbor .crate {
      padding: 0.75em 0.9em; margin: 0 0 0.55em;
      border: 1px solid var(--pm-line); border-radius: 9px;
      background: rgba(255, 252, 244, 0.5);
    }
    .pm .harbor .crate:last-child { margin-bottom: 0; }
    .pm .harbor .crate-top { display: flex; align-items: center; gap: 0.6em; flex-wrap: wrap; }
    .pm .harbor .crate-name { color: var(--pm-ink); font-size: 0.95rem; }
    .pm .harbor .crate-meta {
      display: flex; flex-wrap: wrap; gap: 0.3em 0.7em; margin-top: 0.35em;
      font-family: var(--pm-mono); font-size: 0.66rem; color: var(--pm-ink-soft);
    }
    /* three facts in a row need a mark between them, or they read as one
       run-on clause. The dot rides on the span so a wrap never orphans it. */
    .pm .harbor .crate-meta > span + span::before {
      content: "·"; margin-right: 0.7em; color: var(--pm-line);
    }
    .pm .harbor .crate-body {
      margin: 0.5em 0 0; color: var(--pm-ink-soft);
      font-size: 0.85rem; line-height: 1.55;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ── §4 postmark's own harbor ── */
    .pm .harbor .own { padding: 1.5em 1.7em 1.5em; }
    .pm .harbor .own > p { margin: 0 0 1em; color: var(--pm-ink); font-size: 0.98rem; line-height: 1.65; }
    .pm .harbor .tier { margin: 0 0 1.1em; padding-left: 1.15em; }
    .pm .harbor .tier li { margin: 0 0 0.5em; color: var(--pm-ink); font-size: 0.94rem; line-height: 1.6; }
    .pm .harbor .own > p.own-counts { color: var(--pm-ink-soft); font-size: 0.92rem; }
    .pm .harbor .own > p.own-cta {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.7em 1.2em; margin: 0;
    }
    .pm .harbor .own-alt {
      font-family: var(--pm-mono); font-size: 0.76rem;
      color: var(--pm-accent); text-decoration: none;
      border-bottom: 1px dashed rgba(164, 99, 42, 0.5);
    }
    .pm .harbor .own-alt:hover { color: var(--pm-wax); border-bottom-color: var(--pm-wax); }
  </style>
</PostmarkLayout>
