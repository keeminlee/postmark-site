    .replay .r-digest-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 1.6rem; align-items: start; }
    @media (max-width: 46rem) { .replay .r-digest-grid { grid-template-columns: 1fr; gap: 1.1rem; } }
    .replay .r-col-h {
