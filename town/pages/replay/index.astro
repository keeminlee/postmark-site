      font-size: 0.8rem; line-height: 1.55; color: #b9ad93;
    }
    .replay .r-alpha-tag {
      flex: none;
      font: 0.62rem/1 var(--pm-mono); letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--pm-gold);
    }

    /* The map. The viewer sets `min-height:100vh` on its own root (and 100vh at
       its narrow breakpoint) because it normally IS the page; here it is a panel,
       so the host wins on specificity rather than by editing the viewer. */
    .replay .r-stage { margin: 1.4rem auto 0; }
    .replay .r-map {
      border: 1px solid rgba(232, 196, 139, 0.2); border-radius: 14px; overflow: hidden;
    }
    .replay .r-map.wv, .replay .r-map.wv:not(:root) {
      min-height: 0; height: min(72vh, 44rem); display: flex; flex-direction: column;
    }
    @media (max-width: 48rem) {
      .replay .r-map.wv, .replay .r-map.wv:not(:root) { height: min(64vh, 30rem); }
    }
    .replay .r-map-note {
      margin: 0.6em 0 0; font-size: 0.8rem; line-height: 1.55; color: rgba(185, 173, 147, 0.85);
    }

    /* the scrubber */
    .replay .r-scrub { margin: 1.6rem auto 0; max-width: 52rem; }
    .replay .r-scrub-bar { display: flex; align-items: center; gap: 1rem; justify-content: center; }
    .replay .r-scrub-mid { text-align: center; min-width: 0; flex: 1; }
    .replay .r-when { margin: 0; font-size: 1.15rem; color: var(--pm-gold-bright); }
    .replay .r-span {
      margin: 0.25em 0 0; font: 0.72rem/1.5 var(--pm-mono); letter-spacing: 0.04em;
      color: rgba(232, 196, 139, 0.6);
    }
    .replay .r-arrow {
      flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; cursor: pointer;
      background: rgba(232, 196, 139, 0.08); border: 1px solid rgba(232, 196, 139, 0.45);
      color: var(--pm-gold-bright); font-size: 0.9rem; line-height: 1;
    }
    .replay .r-arrow:hover:not(:disabled) { background: rgba(232, 196, 139, 0.18); border-color: var(--pm-gold-bright); }
    .replay .r-arrow:disabled { opacity: 0.3; cursor: default; }

    /* The track's whole job is to make a busy half-day visibly taller than a
       quiet one. That needs a DEFINITE height to resolve the bars' percentage
       against: with `align-items:flex-end` each item was content-sized, so every
       bar computed its height against `auto` and they all came out the same
       flat line — the one thing the track exists not to do. */
    .replay .r-track {
      list-style: none; display: flex; align-items: stretch; gap: 0.4rem;
      margin: 1.1rem 0 0; padding: 0; height: 5rem;
    }
    .replay .r-tick {
      flex: 1 1 0; height: 100%; min-width: 0;
      display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 0.35em;
    }
    .replay .r-tick-btn {
      width: 100%; height: var(--h, 20%); min-height: 6px; cursor: pointer; padding: 0;
      background: rgba(232, 196, 139, 0.22);
      border: 1px solid rgba(232, 196, 139, 0.3); border-radius: 5px 5px 2px 2px;
    }
    .replay .r-tick-btn:hover { background: rgba(232, 196, 139, 0.45); }
    .replay .r-tick.is-on .r-tick-btn { background: var(--pm-gold); border-color: var(--pm-gold-bright); }
    /* a crossing still being written gets the page's own idiom for unfinished */
    .replay .r-tick.is-open .r-tick-btn { background: transparent; border-style: dashed; }
    .replay .r-tick-n {
      font: 0.62rem/1 var(--pm-mono); color: rgba(232, 196, 139, 0.45);
