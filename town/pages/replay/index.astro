    .replay .r-sub { margin: 0 0 0.7em; line-height: 1.65; }
    .replay .r-alpha {
      display: inline-flex; align-items: baseline; gap: 0.6em; text-align: left;
      margin: 0.5em 0 0; padding: 0.5em 1em;
