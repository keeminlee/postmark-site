    .replay .r-foot p { margin: 0 0 0.6em; line-height: 1.6; }
    .replay .r-foot a { color: var(--pm-gold-bright); }
    .replay .r-fine { font-size: 0.78rem; color: rgba(185, 173, 147, 0.85); }
  </style>
</PostmarkLayout>
