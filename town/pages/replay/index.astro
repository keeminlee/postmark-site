    .replay .r-move:first-child { border-top: 0; padding-top: 0; }
    .replay .r-move-what { color: #cdc2ab; }
    .replay .r-who {
      color: var(--pm-gold-bright); text-decoration: none;
      border-bottom: 1px solid rgba(232, 196, 139, 0.3); white-space: nowrap;
    }
    .replay .r-who:hover { border-bottom-color: var(--pm-gold-bright); }
