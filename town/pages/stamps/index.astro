---
// /stamps/ — THE HUB.
//
// The founder's word, 2026-08-21: "a centralized top-level header page on
// Postmark called Stamps, which just centralizes *everything* stamps." Then,
// having walked the first fold on 2026-08-23: "not just the guide about
// Stamps — the central hub for all things stamps", and on walking that:
// A HUB IS NOT A CONCATENATION.
//
// So this page is about two screens, and it is four things:
//
//   1. the primer — the folk-law and the five sentences that carry a resident
//      through a normal week. Unchanged since it was written.
//   2. the live half — what the town is asking for TODAY: the Bounty Board's
//      notices, read from the world store, and the pots, read from the seam's
//      emission.
//   3. the doors — five one-line ways out, to the surfaces that own the things
//      this page deliberately does not: the dials, the ledger, the map, the
//      earning rows, and the teaching.
//   4. nothing else.
//
// The nine teaching sections that used to sit below all of this now live at
// /stamps/guide/, anchors intact. Astro's redirects map matches PATHS and never
// sees a fragment, so a deep link like /stamps/#earning cannot be redirected by
// configuration — the forwarder at the foot of this file is what keeps those
// links alive. It is load-bearing, not a convenience.
//
// NO LIVE COUNT BEYOND THE BOARD'S OWN. No balances, no treasury, no resident
// totals, and no dial value: R10 names ECONOMY-DIALS.json law_side.keeping.rho
// the owner of the holo cap ratio and says "every other surface reads it rather
// than restating it". The doors point at the surfaces that hold those numbers.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import { HOLO_LINE, livePots, loadPots, POT_FIXTURE } from "@/lib/funding.mjs";
import { loadWorldState, notices, FIXTURE, BOARD_PLACE, ASK_MAX } from "@/lib/board.mjs";

const WORLD = "https://github.com/keeminlee/postmark-world/blob/main";
// The town's signed public ledger — where a stamp, a stake and a pot receipt
// all land. Public reading, no account needed.
const LEDGER = "https://github.com/postmark-town/postmark/blob/main/WHITE_PAGES/stamp-ledger.md";

// ── THE LIVE HALF ────────────────────────────────────────────────────────────
// The Bounty Board and the pots, folded in from /board/ (which now redirects
// here) at the founder's word, 2026-08-23: "not just the guide about Stamps —
// the central hub for all things stamps."
//
// This half is the ONE place on the page that reads the town's moving state,
// and the no-live-count law above is untouched by it: what moves here is the
// town's own asks and its posted needs, not a resident's balance, and every
// number in it is the board's own — never a dial, never a total.
//
// The DEV-gated fixture is /board/'s, carried across whole: `?fixture` or
// SEAM_FIXTURE=1 renders the shape against the documented grammar. Both are
// gated on import.meta.env.DEV, so neither can be reached on postmark.town.
const wantFixture = import.meta.env.DEV &&
  (process.env.SEAM_FIXTURE === "1" || Astro.url.searchParams.has("fixture"));
const board = notices(wantFixture ? FIXTURE : loadWorldState());
const openNotices = board.notices.filter((n) => n.status === "open");
const doneNotices = board.notices.filter((n) => n.status === "done");
const potBoard = livePots(wantFixture ? POT_FIXTURE : loadPots());

const usd = (n) => "$" + Number(n).toLocaleString("en-US");
const pct = (p) => Math.round(Math.max(0, Math.min(1, p)) * 100);

// THE GUIDE'S OWN SECTION LIST, and the forwarder's list at the same time.
// Written once so a section that is renamed or added cannot fall out of the
// forwarder in silence.
const GUIDE_SECTIONS = [
  "what", "earning", "staking", "seam", "minterest",
  "ownership", "faq", "glossary", "check",
];

// THE DOORS. One line each, and each says what is BEHIND the door rather than
// describing the door — nothing on this row restates a number or a law that
// the surface behind it owns.
const DOORS = [
  { href: "/numbers/", label: "The Numbers",
    line: "The economy's dials, read from the ledger's own record — and the only place their values are written down." },
  { href: LEDGER, label: "The Ledger", out: true,
    line: "The signed record itself: every stamp, every stake, every dollar witnessed. Read it back against the town yourself." },
  { href: "/world/", label: "The Map",
    line: "Where the stakes actually stand. A notice is a mark, so the board and the map are one record read twice." },
  { href: "/stamps/guide/#earning", label: "Earning",
    line: "Every way a stamp is minted, quoted from the town's own quest registry." },
  { href: "/stamps/guide/", label: "The Guide",
    line: "The whole teaching — what a stamp is, staking, the funding seam, what your share means, and the law folded under each." },
];
---
<PostmarkLayout
  title="Stamps — Postmark"
  description="Everything stamps, in one place: what the town is asking for today, the pots you can feed, and the doors to the dials, the ledger, the map and the Guide."
  active="stamps"
>
  <main class="pm-wrap stamps">
    <header class="s-head">
      <p class="s-crumb">POSTMARK · STAMPS</p>
      <h1>Stamps ✦</h1>
      <p class="s-sub">
        The town's currency, in one place. What a stamp is in five sentences, what the town
        is asking for today, and the doors to everything else — the dials, the ledger, the
        map, and <a href="/stamps/guide/">the Guide</a>, where the law is folded under every
        part of it.
      </p>
      <p class="s-folk">
        Stamps are the town noticing what you give it. They only come from real
        participation — writing, building, helping, funding — never from buying them.
        Spend them at the market, stake them on what you want the town to become, or just
        hold them: everything you've ever earned is remembered forever, and that memory is
        your share of Postmark.
        <span class="s-cite">— the folk-law, <a href={`${WORLD}/ECONOMY.md`} target="_blank" rel="noopener">ECONOMY.md § 10</a></span>
      </p>
    </header>

    <!-- THE FIRST LAYER. Five plain sentences that carry a resident through a
         normal week. Everything below this is depth, and the page says so. -->
    <section class="s-first" aria-labelledby="first-h">
      <h2 id="first-h">If you read nothing else</h2>
      <ol class="s-five">
        <li>
          <b>You earn stamps by corresponding.</b> A letter that lands mints one to you and
          one to the person you wrote — under caps, so writing more never earns more.
        </li>
        <li>
          <b>You cannot buy one.</b> There is no faucet, no purchase, no conversion in from
          outside. Money never becomes a stamp anywhere in this town.
        </li>
        <li>
          <b>Staking is lending, not spending.</b> Stake on a vote or on something in the
          World and your stamps come home. There is exactly one place a stake is consumed
          instead, and it is the money door — described below, and impossible to walk
          through by accident.
        </li>
        <li>
          <b>What you earned is remembered forever.</b> Spending and staking never lower it.
          That lifetime number is your share of Postmark, and it is public.
        </li>
        <li>
          <b>Ignoring all of it costs you nothing.</b> A resident who only writes letters is
          whole. The commons are free, permanently, at zero stamps.
        </li>
      </ol>
      <p class="s-deeper">
        Below is what the town is actually asking for today — the open notices and the
        posted needs. The machinery behind all of it — how a stamp is minted, what a stake
        does in each of the three places you can put one, how real dollars enter without
        buying anyone a vote, and what "your share" honestly means — lives one door away,
        in <a href="/stamps/guide/">the Guide</a>.
      </p>
    </section>

    <!-- ── THE BOARD ────────────────────────────────────────────────────────
         The Bounty Board, folded in from /board/ whole. A notice IS a world
         mark (`class: bounty`) standing under the board place — nothing here
         is its own database, and nothing here is seeded. The four kinds of
         nothing are kept apart on purpose: a board that invented a notice to
         look alive would be lying about what the town wants. -->
    <section id="board" class="s-sec">
      <h2>The board</h2>
      <p>
        What the town is asking for, right now. One ask to a notice, a reward in stamps,
        and — where the town itself is asking — a bar showing how much the town has put
        behind it. A notice is a mark in the world, so the board and
        the <a href="/world/">map</a> are the same record read two ways.
      </p>
      <!-- Wright's pen owns the doctrine page; this slot holds its place. The
           grammar itself — class: bounty, the pledge child, what neutral means —
           moved to the Guide in POS-34: it is machinery, and the hub points at
           machinery rather than carrying it. -->
      <p class="s-note" data-doctrine-slot>
        Anyone can post one. <a href="/stamps/guide/#staking">How to post a notice</a> — the
        grammar, pledging to someone else's, and why a delivered piece stands neutral until
        its recipient speaks — is in the Guide.
      </p>

      {!board.storeRead && (
        <div class="b-empty b-warn">
          <p><b>The world store could not be read.</b></p>
          <p class="s-dim">
            The board renders from the pinned world record, and this build did not find it.
            That is a build-environment problem, not an empty board — the town may well have
            open asks that are not showing here. Nothing has been invented to fill the gap.
          </p>
        </div>
      )}

      {board.storeRead && !board.boardExists && (
        <div class="b-empty">
          <p><b>The board is not up yet.</b></p>
          <p class="s-dim">
            The world holds no mark at <code>{BOARD_PLACE}</code>, so there is nowhere for a
            notice to stand. When the board place is set down, this page fills itself from
            the record — no second step.
          </p>
        </div>
      )}

      {board.storeRead && board.boardExists && board.notices.length === 0 && (
        <div class="b-empty">
          <p><b>The board is up, and empty.</b></p>
          <p class="s-dim">
            Nobody is asking for anything today. That is a real state of the town and not a
            loading failure — when a notice is posted it appears here on the next build.
          </p>
        </div>
      )}

      {openNotices.length > 0 && (
        <div class="b-list" aria-label="Open notices">
          <h3>Open — {openNotices.length}</h3>
          {openNotices.map((n) => (
            <article class:list={["b-card", n.civic && "b-civic"]}>
              <p class="b-ask">{n.ask}</p>
              <p class="b-meta">
                {n.civic
                  ? <span class="b-tag">the town is asking</span>
                  : <span class="b-who">{n.poster}</span>}
                <span class="b-reward">{n.reward}✦ reward</span>
                {n.date && <span class="s-dim">{n.date}</span>}
              </p>
              {n.body && <p class="b-body">{n.body}</p>}

              {n.threshold ? (
                <div class="b-bar-wrap">
                  <div class="b-bar" role="img"
                       aria-label={`${n.backed} of ${n.threshold} stamps staked`}>
                    <i style={`width:${Math.max(1, pct(n.progress))}%`}></i>
                  </div>
                  <p class="b-bar-label">
                    <b>{n.backed}</b> of {n.threshold} staked
                    {n.backed > n.threshold && <span class="b-over"> · over-subscribed</span>}
                  </p>
                </div>
              ) : (
                <p class="b-backed"><b>{n.backed}</b> backed <span class="s-dim">(ledger_weight)</span></p>
              )}
            </article>
          ))}
        </div>
      )}

      {doneNotices.length > 0 && (
        <div class="b-list b-done-list" aria-label="Closed notices">
          <h3>Done — {doneNotices.length}</h3>
          {doneNotices.map((n) => (
            <article class="b-card b-done">
              <p class="b-ask">{n.ask}</p>
              <p class="b-meta">
                <span class="b-who">{n.poster}</span>
                <span class="b-reward">{n.reward}✦</span>
                {n.date && <span class="s-dim">{n.date}</span>}
              </p>
            </article>
          ))}
          <p class="s-note">A finished notice stays on the board. The town keeps what it asked for.</p>
        </div>
      )}

      {board.malformed.length > 0 && (
        <div class="b-empty b-warn">
          <p><b>{board.malformed.length} notice{board.malformed.length === 1 ? "" : "s"} could not be read.</b></p>
          <p class="s-dim">
            Dropped rather than rendered half-built — and named rather than swallowed, because a
            notice that silently vanishes is worse than one that shows an error. An ask is one
            claim of at most {ASK_MAX} characters, a reward is a whole number of stamps, and a
            status is <code>open</code> or <code>done</code>.
          </p>
          <ul class="s-dim">
            {board.malformed.map((m) => <li><code>{m.id}</code> — {m.reason}</li>)}
          </ul>
        </div>
      )}

      <p class="s-note">
        Backing is shown as <b>ledger_weight</b> — stamps escrowed on a notice plus the town's
        breadth bonus for each unique outside household behind it. It is not the world's
        effective ✦, which the world's own fold derives with terrain and containment on top.
        The board shows what residents put behind an ask; the world decides what it means.
      </p>
    </section>

    <!-- ── THE POTS ─────────────────────────────────────────────────────────
         A pot is a file (WHITE_PAGES/pot-<id>.json) with a row on the quest
         registry, and the site reads the emission made from it. Two shapes,
         and telling them apart is the whole honesty of this section:

           an EPOCH POT posts a need and closes on it. Witnessed dollars match
           staked stamps, the matched share burns, and the burn splits — minted
           back to the stakers for keeping, and holo to the hands that paid.

           a STANDING BOX posts no need and never closes. `close: "none"` in
           the pot file, glossed there: "a standing box, not an epoch pot —
           gifts are witnessed, never converted; nothing here ever burns or
           mints". Saying otherwise on its card would be selling a return the
           box does not pay.

         livePots() holds back any pot the founder has not opened: rendering a
         draft would be the site asking for money the town has not asked for. -->
    <section id="pots" class="s-sec">
      <h2>The pots</h2>
      {potBoard.pots.length === 0 ? (
        <div class="b-empty">
          <p><b>No pot is open.</b></p>
          <p class="s-dim">
            The town is not asking for money today. Opening a pot is the founder's word,
            never a merge — until one is spoken there is nothing here to feed, and nothing
            has been invented to fill the space.
          </p>
        </div>
      ) : (
        <>
        <p>
          A pot is a funding bounty: a named need, and the dollars given against it,
          witnessed on the ledger. What a pot does with what it collects is not one rule —
          some close at the end of a month against a posted need, some let the roll carry
          forward until it is worth closing, and some never close at all. <b>Each pot below
          says which it is, in its own words.</b> The dials behind these numbers hang
          at <a href="/numbers/">the Town's Numbers</a>.
        </p>
        <div class="b-list pots" aria-label="Funding pots">
          {potBoard.pots.map((p) => (
            <article class:list={["b-card", "pot", p.status !== "open" && "pot-settled"]}>
              <p class="b-ask">{p.title}</p>
              {p.source && <p class="pot-source s-dim">{p.source}</p>}
              <p class="b-meta">
                <span class="b-tag">pot · {p.epoch}</span>
                {/* null is a real state: a close refuses a pot with no beneficiary */}
                <span class="b-who">
                  {p.beneficiary
                    ? <>for <code>{p.beneficiary}</code></>
                    : <span class="pot-nobeneficiary">no beneficiary named yet</span>}
                </span>
                <span class="pot-status">{p.status}</span>
                {p.cadence && <span class="s-dim">{p.cadence}</span>}
              </p>
              {/* A TARGETLESS POT HAS NO BAR, because it is short of nothing.
                  D5's exception (ECONOMY-DIALS.json law_side.keeping._intake_cap):
                  "except pots explicitly marked uncapped" — the donation-box
                  shape, "a box with no target takes whatever arrives". Drawing a
                  progress bar for it would invent a need it never posted. */}
              {p.target == null ? (
                <p class="b-bar-label pot-box">
                  {p.close === "elastic"
                    ? <><b>{usd(p.received)}</b> given so far this roll
                      {p.minCloseUsd != null
                        ? <span class="s-dim"> · rolls forward until {usd(p.minCloseUsd)}</span>
                        /* the floor lives in the pot file and is read, never
                           written here — absent, the page says the shape and
                           declines to name a number it was not given */
                        : <span class="s-dim"> · rolls forward until it is worth closing</span>}</>
                    : p.close === "none"
                    ? <><b>{usd(p.received)}</b> given this epoch
                      <span class="s-dim"> · a standing box, no target — whatever arrives is welcome</span></>
                    /* targetless with no word for it. "a standing box" is a
                       claim about what this pot IS, and the record has not
                       made it — so the figure says only what is known. */
                    : <><b>{usd(p.received)}</b> given this epoch
                      <span class="s-dim"> · no posted target</span></>}
                </p>
              ) : (
                <div class="b-bar-wrap">
                  <div class="b-bar pot-bar" role="img"
                       aria-label={`${usd(p.received)} of ${usd(p.target)} received for ${p.epoch}`}>
                    {p.received > 0 && <i class="pm-holo-ink" style={`width:${Math.max(2, pct(p.progress))}%`}></i>}
                  </div>
                  <p class="b-bar-label">
                    <b>{usd(p.received)}</b> of {usd(p.target)} received
                    {p.received === 0 && <span class="s-dim"> · the pot is open, unfed</span>}
                    {p.received > p.target && <span class="b-over"> · over-fed</span>}
                  </p>
                </div>
              )}
              {/* WHAT THIS POT PAYS BACK — per pot, in its own words, and keyed
                  on the pot file's `close` rather than on the boolean. The
                  boolean cannot tell "the town said this never closes" from
                  "the town has not said", and rendering the first sentence for
                  the second case would be a confident claim the record does
                  not support. */}
              <p class="pot-close">
                {p.close === "elastic"
                  ? <><b>This one carries forward.</b> A gift of any size is witnessed and joins
                    the roll — nothing is ever refused at intake. When the roll reaches
                    {p.minCloseUsd != null ? <> {usd(p.minCloseUsd)}</> : <> its floor</>} the
                    month closes: every standing stake converts in full, and{" "}
                    <span class="pot-word pm-holo-ink">holo</span> splits by dollar share of the
                    <b> whole accumulated roll</b>, so an early gift still earns its share whenever
                    the close finally runs. Under that, dollars and stakes both stand and ride to
                    the next month. Holo is {HOLO_LINE}.</>
                  : p.close === "none"
                  ? <><b>Nothing closes here.</b> This one is a standing box, not an epoch pot:
                    a gift is witnessed on the ledger and left at that. Nothing burns, nothing
                    converts, and nothing mints back — to the giver, to the stakers, or to
                    anyone. Stamps staked on it say it matters to you, and come home.</>
                  : p.closes
                  ? <>At the epoch's close, the stakes this pot's dollars matched <b>burn</b>: minted
                    back to the stakers, source-tagged for keeping, and{" "}
                    <span class="pot-word pm-holo-ink">holo</span> to the hands that paid —{" "}
                    {HOLO_LINE}. The beneficiary receives dollars, never stamps.</>
                  /* targetless, and the record carries no close word for it. Not
                     the same as a pot that says it never closes, and the page
                     will not put that sentence in the town's mouth. */
                  : <><b>How this one closes is not in the town's published record yet.</b> It posts
                    no target, and the emission the site reads carries no word for what a close
                    does here — so nothing on this card promises you a return, and nothing
                    promises you there isn't one. Your dollars are witnessed either way.</>}
              </p>
              {p.patrons.length > 0 ? (
                <p class="pot-roll">
                  <span class="pot-roll-lead">the roll · </span>
                  {p.patrons.map((c, i) => (
                    <span class="pot-roll-entry">{i > 0 && " · "}<a href={`/residents/${c.patron}/`}>{c.patron}</a>{" "}
                      <span class="pot-roll-amt">{usd(c.usd)}</span>
                      {/* holo appears on the roll only where a close actually
                          minted it — an open epoch has not split anything yet,
                          and a hollow ✧0 would imply it had. */}
                      {c.holo > 0 && <> <span class="pot-holo pm-holo-ink">✧{c.holo}</span></>}
                    </span>
                  ))}
                </p>
              ) : (
                <p class="pot-roll s-dim">Nobody has fed this pot yet — the roll is open.</p>
              )}
              <p class="pot-escrow s-dim">
                {p.staked > 0
                  ? <><b>{p.staked}✦</b> staked in escrow on this pot</>
                  : "no stamps staked on this pot"}
              </p>
              {/* THE WAY IN — founder-ruled 2026-08-23, lifting the hold the
                  first fold kept. The link is all that lives here: the money
                  moment itself stays on the pot's own page, because the
                  publication law (the USDC runbook, R9) says the address
                  "publishes ONLY beside a pot … never bare on a page". An OPEN
                  pot only: a pot the town has not opened, or has already
                  closed, has no page that can take a dollar. */}
              {p.status === "open" && (
                <p class="pot-fund">
                  <a href={`/fund/${p.pot}/`}>Fund this pot →</a>
                  <span class="s-dim"> the address, what it does and does not buy, and how to be witnessed</span>
                </p>
              )}
            </article>
          ))}
        </div>
        <p class="s-note">✧ holo is soulbound — {HOLO_LINE}. It is never a balance and never spends.</p>
        </>
      )}

      {potBoard.malformed.length > 0 && (
        <div class="b-empty b-warn">
          <p><b>{potBoard.malformed.length} pot{potBoard.malformed.length === 1 ? "" : "s"} could not be read.</b></p>
          <p class="s-dim">
            Dropped rather than rendered half-built — money least of all should appear
            half-said. A pot needs a slug, a title, a status of <code>draft</code>,{" "}
            <code>open</code> or <code>closed</code>, an epoch of <code>YYYY-MM</code>,
            and a whole-dollar target of at least $1.
          </p>
          <ul class="s-dim">
            {potBoard.malformed.map((m) => <li><code>{m.id}</code> — {m.reason}</li>)}
          </ul>
        </div>
      )}
    </section>


    <!-- ── THE DOORS ────────────────────────────────────────────────────────
         Five ways out, one line each. A hub's job is to be the shortest route
         to the thing you actually came for, and every one of these surfaces
         OWNS something this page deliberately refuses to hold: the dials, the
         signed record, the map the stakes stand on, the earning rows, and the
         teaching. Nothing on this row restates what is behind it. -->
    <section id="doors" class="s-sec">
      <h2>Where to go next</h2>
      <ul class="s-doors">
        {DOORS.map((d) => (
          <li class="s-door">
            <a href={d.href} {...(d.out ? { target: "_blank", rel: "noopener" } : {})}>
              {d.label}{d.out && <span class="s-door-out" aria-label="opens on GitHub"> ↗</span>}
            </a>
            <span class="s-door-line">{d.line}</span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="s-foot">
      <p>
        This page is a reading of the town's law, not a second authority. Where it
        disagrees with the town's own files — linked from
        <a href="/stamps/guide/">the Guide</a>, which quotes every one of them — those are
        right and this is a bug. All of them are public reading, no account needed.
      </p>
      <p>✦ stamps are earned. ✧ holo is {HOLO_LINE}. Voice is only ever earned.</p>
    </footer>
  </main>
</PostmarkLayout>

<!-- THE GUIDE FORWARDER — load-bearing, not a convenience.
     The teaching moved to /stamps/guide/ with its anchor ids intact. Astro's
     `redirects` map matches PATHS, and a fragment is never sent to the server,
     so /stamps/#earning — the exact shape of every deep link ever written into
     the teaching — cannot be redirected by configuration. Without this script,
     "the teaching moved" and "every deep link into the teaching broke" would be
     the same commit.

     `replace`, not `assign`: the reader's Back button must return where they
     came from, not bounce them through this page and round the loop again.

     The id list is the Guide's own, passed in rather than retyped, so a renamed
     or added section cannot fall out of the forwarder in silence. And it checks
     document.getElementById first: if a hub section ever takes one of these
     names, the hub wins and nobody is sent away from a section that is right
     here. -->
<script is:inline define:vars={{ GUIDE_SECTIONS }}>
  (function () {
    function forward() {
      var hash = window.location.hash;
      if (!hash || hash.length < 2) return;
      var id = decodeURIComponent(hash.slice(1));
      if (GUIDE_SECTIONS.indexOf(id) === -1) return;
      if (document.getElementById(id)) return;
      window.location.replace("/stamps/guide/#" + id);
    }
    forward();
