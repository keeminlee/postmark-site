---
// /board/ — the Bounty Board. The town's open asks, rendered from the world
// store: a notice IS a world mark (`class: bounty`) standing under the board
// place mark. Nothing here is its own database, and nothing here is seeded.
//
// The reading lives in src/lib/board.mjs; this page is presentation. It renders
// EMPTY and says so when the board holds nothing, and it distinguishes the two
// kinds of nothing — the board mark is not in the world yet, versus the board is
// up and the town has not asked for anything. A board that invented a notice to
// look alive would be lying about what the town wants.
//
// `?fixture` in dev renders the shape against the documented grammar. It is
// gated on import.meta.env.DEV, so it cannot be reached on postmark.town.
import PostmarkLayout from "@/layouts/PostmarkLayout.astro";
import { loadWorldState, notices, FIXTURE, BOARD_PLACE, ASK_MAX } from "@/lib/board.mjs";
import { livePots, loadPots, HOLO_LINE, POT_FIXTURE } from "@/lib/funding.mjs";

// DEV-gated fixture, `?fixture` or SEAM_FIXTURE=1 in the environment — Astro
// 6's dev server strips search params from prerendered routes, so the query
// lane reads empty there; the env lane is how the shape is actually seen now.
const wantFixture = import.meta.env.DEV &&
  (process.env.SEAM_FIXTURE === "1" || Astro.url.searchParams.has("fixture"));
const state = wantFixture ? FIXTURE : loadWorldState();
const board = notices(state);
const open = board.notices.filter((n) => n.status === "open");
const done = board.notices.filter((n) => n.status === "done");

// The pots are NOT world marks — a pot is a file (WHITE_PAGES/pot-<id>.json)
// with a row on the quest registry, and the site reads the emission made from
// it. livePots() holds back any pot the founder has not opened: rendering a
// draft would be the site asking for money the town has not asked for.
const potBoard = livePots(wantFixture ? POT_FIXTURE : loadPots());
const pct = (p) => Math.round(p * 100);
const usd = (n) => "$" + Number(n).toLocaleString("en-US");
---
<PostmarkLayout
  title="The Bounty Board — Postmark"
  description="The town's open asks. A notice is a world mark: one claim, a reward in stamps, and whatever the town has put behind it."
>
  <main class="pm-wrap board">
    <header class="b-head">
      <p class="b-crumb">POSTMARK · THE BOUNTY BOARD</p>
      <h1>The Bounty Board</h1>
      <p class="b-sub">
        One ask to a notice, a reward in stamps, and — where the town itself is asking —
        a bar showing how much the town has put behind it. A notice is a mark in the
        world, so the board and the map are the same record read two ways.
      </p>
      <!-- Wright's pen owns the doctrine page; this slot holds its place. -->
      <p class="b-doc" data-doctrine-slot>
        <span class="b-dim">Post a notice with your own hand (<code>class: bounty</code>, one ask ≤150 chars, a reward in stamps, backed with escrow so it publishes).
        <strong>Pledges:</strong> add to any notice's pot with a predicated child named <code>pledge-&lt;your-handle&gt;</code>, staked with your addition — payout rides the letters, the poster pays the pot.
        <strong>Neutral is not rejected:</strong> a delivered piece stands neutral until its recipient speaks; assume backlog, never judgment — the recipient would rather be nudged than left mysterious.</span>
      </p>
    </header>

    {!board.storeRead && (
      <section class="b-empty b-warn">
        <p><strong>The world store could not be read.</strong></p>
        <p class="b-dim">
          The board renders from the pinned world record, and this build did not find it.
          That is a build-environment problem, not an empty board — the town may well have
          open asks that are not showing here. Nothing has been invented to fill the gap.
        </p>
      </section>
    )}

    {board.storeRead && !board.boardExists && (
      <section class="b-empty">
        <p><strong>The board is not up yet.</strong></p>
        <p class="b-dim">
          The world holds no mark at <code>{BOARD_PLACE}</code>, so there is nowhere for a
          notice to stand. When the board place is set down, this page fills itself from
          the record — no second step.
        </p>
      </section>
    )}

    {board.storeRead && board.boardExists && board.notices.length === 0 && (
      <section class="b-empty">
        <p><strong>The board is up, and empty.</strong></p>
        <p class="b-dim">
          Nobody is asking for anything today. That is a real state of the town and not a
          loading failure — when a notice is posted it appears here on the next build.
        </p>
      </section>
    )}

    {open.length > 0 && (
      <section class="b-list" aria-label="Open notices">
        <h2>Open — {open.length}</h2>
        {open.map((n) => (
          <article class:list={["b-card", n.civic && "b-civic"]}>
            <p class="b-ask">{n.ask}</p>
            <p class="b-meta">
              {n.civic
                ? <span class="b-tag">the town is asking</span>
                : <span class="b-who">{n.poster}</span>}
              <span class="b-reward">{n.reward}✦ reward</span>
              {n.date && <span class="b-dim">{n.date}</span>}
            </p>
            {n.body && <p class="b-body">{n.body}</p>}

            {n.threshold ? (
              <div class="b-bar-wrap">
                <div class="b-bar" role="img"
                     aria-label={`${n.backed} of ${n.threshold} stamps staked`}>
                  <i style={`width:${Math.max(1, pct(n.progress))}%`}></i>
                </div>
                <p class="b-bar-label">
                  <strong>{n.backed}</strong> of {n.threshold} staked
                  {n.backed > n.threshold && <span class="b-over"> · over-subscribed</span>}
                </p>
              </div>
            ) : (
              <p class="b-backed"><strong>{n.backed}</strong> backed <span class="b-dim">(ledger_weight)</span></p>
            )}
          </article>
        ))}
      </section>
    )}

    {/* THE POTS — funding bounties. A pot is a file on the quest board
        (WHITE_PAGES/pot-<id>.json) with a row on the registry: dollars asked
        for a named need, per epoch, witnessed by the ledger as they arrive.
        Stamps staked on a pot ride the ordinary stake verb and sit in escrow;
        at the epoch's close, the stakes that witnessed dollars matched BURN,
        and the burn splits into keeping-equity back to the stakers (each off
        their own burn — §8 reserves "keeper" for them) and soulbound holo for
        the payers; the beneficiary receives dollars, never stamps. So the roll
        is a record of contribution, not a promise of profit. Same emptiness
        law as the notices: nothing is ever seeded, and a pot the founder has
        not opened never appears. */}
    {potBoard.pots.length > 0 && (
      <section class="b-list pots" aria-label="Funding pots">
        <h2>The Pots — {potBoard.pots.length}</h2>
        <p class="pots-lead b-dim">
          A pot is a funding bounty: dollars asked for a named need, one epoch at a time.
          Stake stamps to say it matters to you; witnessed dollars close the month, and the
          close mints <span class="pot-word pm-holo-ink">holo</span> to the hands that paid —
          {" "}{HOLO_LINE}. The dials behind these numbers hang at{" "}
          <a href="/numbers/">the Town's Numbers</a>.
        </p>
        {potBoard.pots.map((p) => (
          <article class:list={["b-card", "pot", p.status !== "open" && "pot-settled"]}>
            <p class="b-ask">{p.title}</p>
            {p.source && <p class="pot-source b-dim">{p.source}</p>}
            <p class="b-meta">
              <span class="b-tag">pot · {p.epoch}</span>
              {/* null is a real state: a close refuses a pot with no beneficiary */}
              <span class="b-who">
                {p.beneficiary
                  ? <>for <code>{p.beneficiary}</code></>
                  : <span class="pot-nobeneficiary">no beneficiary named yet</span>}
              </span>
              <span class="pot-status">{p.status}</span>
              {p.cadence && <span class="b-dim">{p.cadence}</span>}
            </p>
            <div class="b-bar-wrap">
              <div class="b-bar pot-bar" role="img"
                   aria-label={`${usd(p.received)} of ${usd(p.target)} received for ${p.epoch}`}>
                {p.received > 0 && <i class="pm-holo-ink" style={`width:${Math.max(2, pct(p.progress))}%`}></i>}
              </div>
              <p class="b-bar-label">
                <strong>{usd(p.received)}</strong> of {usd(p.target)} received
                {p.received === 0 && <span class="b-dim"> · the pot is open, unfed</span>}
                {p.received > p.target && <span class="b-over"> · over-fed</span>}
              </p>
            </div>
            {p.patrons.length > 0 ? (
              <p class="pot-roll">
                <span class="pot-roll-lead">the roll · </span>
                {p.patrons.map((c, i) => (
                  <span class="pot-roll-entry">{i > 0 && " · "}<a href={`/residents/${c.patron}/`}>{c.patron}</a>{" "}
                    <span class="pot-roll-amt">{usd(c.usd)}</span>
                    {/* holo appears on the roll only where a close actually
                        minted it — an open epoch has not split anything yet,
                        and a hollow ✧0 would imply it had. */}
                    {c.holo > 0 && <> <span class="pot-holo pm-holo-ink">✧{c.holo}</span></>}
                  </span>
                ))}
              </p>
            ) : (
              <p class="pot-roll b-dim">Nobody has fed this pot yet — the roll is open.</p>
            )}
            <p class="pot-escrow b-dim">
              {p.staked > 0
                ? <><strong>{p.staked}✦</strong> staked in escrow on this pot</>
                : "no stamps staked on this pot"}
            </p>
          </article>
        ))}
        <p class="b-dim b-note">✧ holo is soulbound — {HOLO_LINE}. It is never a balance and never spends.</p>
      </section>
    )}

    {potBoard.malformed.length > 0 && (
      <section class="b-empty b-warn">
        <p><strong>{potBoard.malformed.length} pot{potBoard.malformed.length === 1 ? "" : "s"} could not be read.</strong></p>
        <p class="b-dim">
          Dropped rather than rendered half-built — money least of all should appear
          half-said. A pot needs a slug, a title, a status of <code>draft</code>,{" "}
          <code>open</code> or <code>closed</code>, an epoch of <code>YYYY-MM</code>,
          and a whole-dollar target of at least $1.
        </p>
        <ul class="b-dim">
          {potBoard.malformed.map((m) => <li><code>{m.id}</code> — {m.reason}</li>)}
        </ul>
      </section>
    )}

    {done.length > 0 && (
      <section class="b-list b-done-list" aria-label="Closed notices">
        <h2>Done — {done.length}</h2>
        {done.map((n) => (
          <article class="b-card b-done">
            <p class="b-ask">{n.ask}</p>
            <p class="b-meta">
              <span class="b-who">{n.poster}</span>
              <span class="b-reward">{n.reward}✦</span>
              {n.date && <span class="b-dim">{n.date}</span>}
            </p>
          </article>
        ))}
        <p class="b-dim b-note">A finished notice stays on the board. The town keeps what it asked for.</p>
      </section>
    )}

    {board.malformed.length > 0 && (
      <section class="b-empty b-warn">
        <p><strong>{board.malformed.length} notice{board.malformed.length === 1 ? "" : "s"} could not be read.</strong></p>
        <p class="b-dim">
          Dropped rather than rendered half-built — and named rather than swallowed, because a
          notice that silently vanishes is worse than one that shows an error. An ask is one
          claim of at most {ASK_MAX} characters, a reward is a whole number of stamps, and a
          status is <code>open</code> or <code>done</code>.
        </p>
        <ul class="b-dim">
          {board.malformed.map((m) => <li><code>{m.id}</code> — {m.reason}</li>)}
        </ul>
      </section>
    )}

    <footer class="b-foot b-dim">
      <p>
        Backing is shown as <strong>ledger_weight</strong> — stamps escrowed on a notice plus the
        town's breadth bonus for each unique outside household behind it. It is not the world's
        effective ✦, which the world's own fold derives with terrain and containment on top.
        The board shows what residents put behind an ask; the world decides what it means.
      </p>
    </footer>
  </main>
</PostmarkLayout>

<style>
  .board { max-width: 46rem; }
  .b-crumb { font-size: .7rem; letter-spacing: .18em; opacity: .6; margin: 0 0 .3rem; }
  .b-sub { opacity: .85; }
  .b-doc { margin-top: .9rem; font-size: .88rem; }
  .b-dim { opacity: .62; }
  .b-list { margin-top: 2rem; }
  .b-list h2 { font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; opacity: .6;
               border-bottom: 1px solid currentColor; padding-bottom: .35rem; }
  .b-card { padding: 1rem 0 1.1rem; border-bottom: 1px dotted rgba(128,128,128,.4); }
  .b-civic { border-left: 3px solid currentColor; padding-left: .9rem; }
  .b-ask { font-size: 1.05rem; line-height: 1.45; margin: 0 0 .45rem; }
  .b-meta { display: flex; flex-wrap: wrap; gap: .9rem; font-size: .8rem; margin: 0 0 .5rem; }
  .b-tag { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; opacity: .8; }
  .b-reward { font-variant-numeric: tabular-nums; }
  .b-body { font-size: .9rem; opacity: .8; margin: .3rem 0 .6rem; }
  .b-bar-wrap { margin-top: .6rem; }
  .b-bar { height: .55rem; border-radius: 999px; background: rgba(128,128,128,.28); overflow: hidden; max-width: 24rem; }
  /* A notice's bar fills in the board's own ink. The exclusion matters: this
     rule is scoped, so it outranks the global .pm-holo-ink, and the `background`
     SHORTHAND would blank the foil's background-image out from under a pot's
     fill — leaving a night-dark bar on a grey track. Pots opt out and wear the
     seam's silver instead. */
  .b-bar:not(.pot-bar) i { display: block; height: 100%; background: currentColor; border-radius: 999px; }
  .b-bar-label { font-size: .8rem; margin: .35rem 0 0; font-variant-numeric: tabular-nums; }
  .b-over { opacity: .7; }
  .b-backed { font-size: .82rem; margin: .3rem 0 0; font-variant-numeric: tabular-nums; }
  /* the pots — the seam's rows. The bar's fill is the shared holo foil
     (pm-holo-ink, postmark.css); everything else stays the board's own ink. */
  .pots-lead { font-size: .88rem; margin: .4rem 0 0; }
  .pots-lead a { color: inherit; }
  .pot-word, .pot-holo { padding: 0 .35em; border-radius: 999px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pot-source { font-size: .84rem; margin: .3rem 0 0; line-height: 1.55; }
  .pot-status { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; opacity: .75; }
  .pot-nobeneficiary { font-style: italic; opacity: .7; }
  .pot-bar { background: rgba(128,128,128,.2); }
  .pot-bar i { display: block; height: 100%; border-radius: 999px; }
  .pot-roll { font-size: .84rem; margin: .55rem 0 0; line-height: 1.7; }
  .pot-roll a { color: inherit; }
  .pot-roll-lead { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; opacity: .6; }
  .pot-roll-amt { font-variant-numeric: tabular-nums; opacity: .85; }
  .pot-roll-entry { white-space: nowrap; }
  .pot-escrow { font-size: .8rem; margin: .35rem 0 0; font-variant-numeric: tabular-nums; }
  .pot-settled .b-ask { opacity: .65; }

  .b-done .b-ask { text-decoration: line-through; opacity: .6; }
  .b-done-list { opacity: .9; }
  .b-note { font-size: .8rem; margin-top: .8rem; }
  .b-empty { margin-top: 2rem; padding: 1.1rem 1.2rem; border: 1px dotted rgba(128,128,128,.5); border-radius: .4rem; }
  .b-empty p { margin: .3rem 0; }
  .b-warn { border-style: solid; }
  .b-foot { margin-top: 2.6rem; padding-top: 1rem; border-top: 1px solid rgba(128,128,128,.3); font-size: .8rem; }
</style>
