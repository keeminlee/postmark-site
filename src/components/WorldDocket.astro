---
// THE PUBLIC DOCKET — what P-108's private draft-overlay becomes.
//
// A BEHAVIOUR CHANGE, not a port, and the parity matrix says so in as many
// words: P-108 is "TRICKY — gold §4's named row: overlay→docket parity is a
// behavior change". Today a signed-in household sees ITS OWN unpublished marks
// merged into the world in draft grey, boots off `localStorage['pm_key']`, and
// nobody else can see them; the office reads them out of that household's
// `draft/<household>` git branch. Tomorrow there are no draft branches, and what
// replaces the private lens is a docket that is PUBLIC — gold §1: "the candle
// becomes an honest public docket ('here is everything that locks at 17:45'),
// queryable, contestable, retractable."
//
// That is the whole point of the candle and it is also the thing to look at
// hard: a resident who could previously sketch a mark unseen until the sweep
// published it is now sketching in a window everyone can read. Counterclaims
// only become possible because of it (gold §1: "pending claims are practically
// unseeable, so counterclaims — half the point of an epochal threshold — barely
// exist"), and the price is that nothing is private while it is pending. This
// component exists so that trade is looked at as a rendered page rather than
// argued from a paragraph.
//
// It reads /world2/docket at build time and holds no state of its own. When the
// door cannot answer, it says the docket could not be read rather than showing
// an empty one — an empty docket and an unreachable docket look identical to a
// reader, and only one of them means "nothing is pending".
import { doorDocket, doorUrl } from '../../tools/world2-door.mjs';

let docket = null, failure = null;
try {
  docket = await doorDocket();
} catch (e) {
  failure = String(e?.message ?? e).split("\n")[0];
}

const win = docket?.window ?? null;
const claims = docket?.claims ?? [];
const fmt = (iso) => iso
  ? new Date(iso).toLocaleString("en-US", { timeZone: "UTC", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false }) + " UTC"
  : "—";

// AN OPEN WINDOW WHOSE CLOSE HAS PASSED is a real state and this page met it on
// its first build: the door answered window 154, status open, closes_at already
// hours behind. It means the clearing has not run, not that the candle is still
// burning, and saying "the candle burns to 05:45" about a time in the past is
// the kind of quiet lie the sentinel era was full of. Named instead.
const overdue = Boolean(win?.closes_at) && Date.parse(win.closes_at) < Date.now();
---

<section class="pm-docket" data-closes={win?.closes_at ?? ''}>
  <header class="pm-docket-head">
    <p class="pm-docket-kicker">The public docket</p>
    {win && (
      <p class={`pm-docket-window${overdue ? ' is-overdue' : ''}`}>
        Window <b>{win.id}</b> · {overdue ? 'was due' : 'closes'} {fmt(win.closes_at)}
        <span class="pm-docket-countdown" hidden></span>
      </p>
    )}
  </header>

  {failure ? (
    <p class="pm-docket-note pm-docket-fail">The docket could not be read from the door. This is not an empty docket — it is an unread one. <span>{failure}</span></p>
  ) : (
    <>
      <p class="pm-docket-note">
        Everything standing here locks together when the candle closes — computed against
        each other in one go, not first-come. Until then a claim can be contested, and
        withdrawn for free. <b>Anyone can read this,</b> signed in or not: a pending claim
        is a public fact, which is what makes contesting one possible.
      </p>

      {claims.length === 0 ? (
        <p class="pm-docket-empty">{overdue
          ? `Nothing is pending, and this window's close time has passed — it is still open, so the clearing has not run yet.`
          : `Nothing is pending. The candle burns to ${fmt(win?.closes_at)} with an empty docket.`}</p>
      ) : (
        <ol class="pm-docket-list">
          {claims.map((c) => (
            <li class={`pm-docket-claim${c.counterclaim_of ? ' is-counter' : ''}`}>
              <p class="pm-docket-claim-head">
                <span class="pm-docket-class">{c.class ?? 'claim'}</span>
                <span class="pm-docket-by">{c.claimant}</span>
                {c.household && <span class="pm-docket-house">{c.household}</span>}
              </p>
              <p class="pm-docket-claim-meta">
                submitted {fmt(c.submitted_at)}
                {c.stake != null && <> · stake {c.stake}</>}
                {c.geometry?.at && <> · at {c.geometry.at.x}, {c.geometry.at.y}</>}
              </p>
              {c.counterclaim_of && <p class="pm-docket-counter">contests claim {c.counterclaim_of}</p>}
            </li>
          ))}
        </ol>
      )}
    </>
  )}
  <p class="pm-docket-source">read from {doorUrl()} at build</p>
</section>

{/* WHERE IT SITS. The docket is town-wide news, not desk furniture, so it wants
    the full-width strip above the viewer's three-column grid — the seat the BETA
    chip's own row occupies — rather than a corner. Every corner of the painting
    is already spoken for (walk desk bottom-right, coordinate chip bottom-centre,
    time travel bottom-left of the rail, sign-in top-right), and the docket is a
    thing you READ, which a 17rem popover is the wrong shape for.

    It is MOVED rather than built in JS: Astro renders the real section above, and
    this only relocates the finished node once the viewer's own markup exists. If
    the move never happens — the viewer's structure changed, the mount failed —
    the docket is still on the page, below the viewer, fully readable. A docket
    that quietly disappeared because a selector moved would be the worst possible
    failure for the one surface whose entire job is being seen. */}
<script is:inline>
  (function () {
    var el = document.querySelector(".pm-docket");
    if (!el) return;
    var tries = 0;
    (function place() {
      var main = document.querySelector(".wv .wv-main");
      if (!main || !main.parentNode) { if (tries++ < 200) return setTimeout(place, 100); return; }
      main.parentNode.insertBefore(el, main);
      el.classList.add("is-placed");
      // The cluster takes its seat on a later frame (WorldSignIn retries `seat`
      // through requestAnimationFrame), so asking once here would read "fixed"
      // on a desktop that is about to seat it and leave a band of padding under
      // nothing. Asked again as the page settles, and on every resize after.
      clear();
      for (var t = 1; t <= 4; t++) setTimeout(clear, t * 400);
      window.addEventListener("resize", clear);
    })();

    // THE TOP OF A PHONE IS ALREADY SPOKEN FOR, twice, and this is in the flow
    // underneath both. Below 720px the viewer hides the rail, so the site's
    // back-link and auth pill lose the seat they take in it and go
    // position:fixed at the top of the screen (WorldSignIn: "it notices the seat
    // has gone and floats instead — it is the only human door"), and the time
    // travel panel hangs from the same edge for the same reason, measured to sit
    // just under that cluster (its own `place()`). Both landed on the docket in
    // turn — the auth row across the kicker, then the Time travel chip across
    // the close time.
    //
    // So the clearance is measured against WHATEVER is actually floating there,
    // not against one named neighbour, and takes the lowest of them. Same reason
    // the time-travel panel measures rather than picking a corner: those heights
    // are their own components' business and a number copied here would be one
    // more to drift. On a desktop nothing up there is fixed and this does
    // nothing at all.
    function clear() {
      var bottom = 0;
      ["#pm-world-auth", ".pm-tt"].forEach(function (sel) {
        var n = document.querySelector(sel);
        if (!n || !n.getClientRects().length) return;
        if (getComputedStyle(n).position !== "fixed") return;
        var box = n.getBoundingClientRect();
        // only things hanging from the TOP edge crowd this; the panel pinned to
        // the bottom on a desktop is not in anybody's way
        if (box.top > window.innerHeight / 2) return;
        bottom = Math.max(bottom, box.bottom);
      });
      el.style.paddingTop = bottom ? Math.round(bottom + 10) + "px" : "";
    }

    // The countdown is the candle. It is client-side because a build-time
    // "closes in 9 hours" is wrong by however long the page has been open, and
    // this is the one number a reader deciding whether to contest something acts
    // on. Absent closes_at, it simply never shows.
    var closes = el.getAttribute("data-closes");
    var out = el.querySelector(".pm-docket-countdown");
    if (!closes || !out) return;
    var at = Date.parse(closes);
    if (!isFinite(at)) return;
    (function tick() {
      var left = at - Date.now();
      if (left <= 0) { out.textContent = "· past its close, not yet cleared"; out.hidden = false; return; }
      var h = Math.floor(left / 3600000), m = Math.floor(left / 60000) % 60;
      out.textContent = "· " + (h >= 24 ? Math.floor(h / 24) + "d " + (h % 24) + "h" : h > 0 ? h + "h " + m + "m" : m + "m") + " left";
      out.hidden = false;
      setTimeout(tick, 30000);
    })();
  })();
</script>

<style is:global>
  /* The viewer's own palette, spelled out rather than inherited: this section is
     rendered by Astro OUTSIDE the .wv host and only moved inside afterwards, so
     it cannot rely on .wv's custom properties existing when it first paints. */
  .pm-docket {
    --d-panel: #1c2129; --d-line: #2e3542; --d-paper: #e8e0cf;
    --d-dim: #9a9280; --d-amber: #e8c56a; --d-amber-dark: #b8964a;
    --d-mono: ui-monospace, "SF Mono", Consolas, Menlo, monospace;
    margin: 0; padding: 13px 16px 12px;
    background: var(--d-panel); color: var(--d-paper);
    border-bottom: 1px solid var(--d-line);
    border-left: 3px solid var(--d-amber-dark);
    font: 16px/1.55 Georgia, "Times New Roman", serif;
  }
  .pm-docket.is-placed { border-top: 1px solid var(--d-line); }
  .pm-docket-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 14px; margin: 0 0 6px; }
  .pm-docket-kicker {
    margin: 0; font-family: var(--d-mono); font-size: .62rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--d-amber); font-weight: 600;
  }
  .pm-docket-window { margin: 0; font-family: var(--d-mono); font-size: .68rem; color: var(--d-dim); }
  .pm-docket-window b { color: var(--d-paper); font-weight: 600; }
  .pm-docket-countdown { color: var(--d-amber); margin-left: .5em; }
  .pm-docket-window.is-overdue, .pm-docket-window.is-overdue .pm-docket-countdown { color: #d98a7a; }
  .pm-docket-note { margin: 0; max-width: 78ch; font-size: .82rem; line-height: 1.5; color: var(--d-dim); }
  .pm-docket-note b { color: var(--d-paper); font-weight: 600; }
  .pm-docket-fail { color: #d98a7a; }
  .pm-docket-fail span { display: block; font-family: var(--d-mono); font-size: .66rem; opacity: .8; margin-top: .3em; }
  .pm-docket-empty { margin: .55em 0 0; font-style: italic; font-size: .84rem; color: var(--d-dim); }
  .pm-docket-list { margin: .7em 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .pm-docket-claim {
    flex: 1 1 22rem; max-width: 30rem; padding: .5em .7em; border-radius: 4px;
    background: #20262f; border: 1px solid var(--d-line); border-left: 2px solid var(--d-amber-dark);
  }
  .pm-docket-claim.is-counter { border-left-color: #d98a7a; }
  .pm-docket-claim-head { margin: 0; display: flex; align-items: baseline; flex-wrap: wrap; gap: .5em; }
  .pm-docket-class {
    font-family: var(--d-mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase;
    color: var(--d-amber); border: 1px solid rgba(232, 197, 106, .45); border-radius: 3px; padding: 1px 6px;
  }
  .pm-docket-by { font-size: .9rem; color: var(--d-paper); }
  .pm-docket-house { font-family: var(--d-mono); font-size: .62rem; color: var(--d-dim); }
  .pm-docket-claim-meta { margin: .25em 0 0; font-family: var(--d-mono); font-size: .62rem; color: var(--d-dim); }
  .pm-docket-counter { margin: .25em 0 0; font-size: .74rem; color: #d98a7a; }
  .pm-docket-source { margin: .6em 0 0; font-family: var(--d-mono); font-size: .56rem; color: rgba(154, 146, 128, .6); }
  /* A phone gets the docket too — it is the surface whose whole change is that
     everyone can see it, so it is the last thing that should drop at a breakpoint.
     It only gets quieter: the strapline is the part a small screen can spare. */
  @media (max-width: 720px) {
    .pm-docket { padding: 10px 12px; }
    .pm-docket-note { display: none; }
    .pm-docket-claim { flex-basis: 100%; }
  }
</style>
