---
// Ruling 9's site surface. The active viewer stays pinned until the first
// Worldkeeper settlement; this island supplies the household overlay, portfolio,
// axes, and stake door in the meantime, then feature-detects the viewer's native
// axes at the pin bump so the two implementations never render together.
---
<aside id="pm-my-world-islands" class="mwi-shell" hidden aria-live="polite"></aside>

<template id="pm-my-world-template">
  <div class="mwi" data-mwi-panel>
    <header class="mwi-head">
      <div>
        <span class="mwi-kicker">YOUR HOUSEHOLD · THE TOLD WORLD</span>
        <h2>My World</h2>
      </div>
      <p class="mwi-status" data-mwi-status>Opening your sketchbook…</p>
    </header>

    <section class="mwi-fallback" data-mwi-fallback>
      <div class="mwi-axes" aria-label="World view">
        <div class="mwi-axis">
          <span>world</span>
          <button type="button" class="mwi-chip on" data-world-base="true" aria-pressed="true">the True World</button>
          <button type="button" class="mwi-chip" data-world-base="mine" aria-pressed="false">My World</button>
        </div>
        <div class="mwi-axis">
          <span>marks</span>
          <button type="button" class="mwi-chip on" data-mine-filter="everything" aria-pressed="true">everything</button>
          <button type="button" class="mwi-chip" data-mine-filter="mine" aria-pressed="false">just mine</button>
        </div>
      </div>
      <p class="mwi-law">The True World is what the town has settled. My World adds what your household is still sketching.</p>

      <section class="mwi-drafts" data-mwi-draft-overlay hidden>
        <div class="mwi-section-head">
          <h3>Pending in My World</h3>
          <span><b data-mwi-draft-count>0</b> private</span>
        </div>
        <div data-mwi-draft-cards></div>
      </section>
    </section>

    <section class="mwi-portfolio" aria-label="My marks portfolio">
      <div class="mwi-section-head">
        <h3>My marks</h3>
        <span>household portfolio</span>
      </div>
      <div class="mwi-categories">
        <details open data-mwi-category="drafts">
          <summary>Drafts <b data-mwi-count>0</b></summary>
          <div data-mwi-rows></div>
        </details>
        <details open data-mwi-category="published">
          <summary>Published <b data-mwi-count>0</b></summary>
          <div data-mwi-rows></div>
        </details>
        <details open data-mwi-category="backed">
          <summary>Backed <b data-mwi-count>0</b></summary>
          <div data-mwi-rows></div>
        </details>
      </div>
    </section>

    <section class="mwi-door" data-mwi-door hidden aria-label="World mark stake">
      <div class="mwi-section-head">
        <h3 data-mwi-door-title>Back this mark</h3>
        <button type="button" class="mwi-close" data-mwi-close aria-label="Close stake panel">×</button>
      </div>
      <label class="mwi-field">
        <span>mark</span>
        <input type="text" data-mwi-mark readonly />
      </label>
      <label class="mwi-field">
        <span>resident acting</span>
        <select data-mwi-handle></select>
      </label>
      <label class="mwi-field">
        <span>stamps</span>
        <input type="number" min="1" step="1" inputmode="numeric" data-mwi-stamps />
      </label>
      <button type="button" class="mwi-action" data-mwi-make-preview>Preview the sealed line</button>

      <div class="mwi-preview" data-mwi-preview hidden>
        <span>the exact line the office will seal</span>
        <pre data-mwi-preview-line></pre>
        <p>The office fills the signature at the tail. This line moves escrow now; <b>weight updates at the next crossing</b>.</p>
        <button type="button" class="mwi-action mwi-confirm" data-mwi-confirm disabled>Confirm and send to the office</button>
      </div>
      <p class="mwi-answer" data-mwi-answer hidden></p>
    </section>
  </div>
</template>

<script>
  import { mountMyWorldIslands } from "@/lib/my-world.mjs";

  const root = document.getElementById("pm-my-world-islands");
  const template = document.getElementById("pm-my-world-template");
  mountMyWorldIslands(root, template);
</script>

<style is:global>
  .mwi-shell {
    --mwi-violet: #aa8fd8;
    --mwi-violet-dark: #65517f;
    --mwi-ink: #e8e0cf;
    --mwi-dim: #9a9280;
    --mwi-line: #3b3832;
    margin: 0 0 16px;
    color: var(--mwi-ink);
    font-family: Georgia, "Times New Roman", serif;
  }
  .mwi-shell[hidden],
  .mwi-shell [hidden] { display: none !important; }
  .mwi {
    border: 1px solid var(--mwi-violet-dark);
    border-left: 4px solid var(--mwi-violet);
    border-radius: 6px;
    background: linear-gradient(135deg, rgba(93, 68, 119, 0.18), rgba(20, 23, 29, 0.96) 46%);
    padding: 14px 16px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
  }
  .mwi-head,
  .mwi-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .mwi-head { margin-bottom: 12px; }
  .mwi-head h2,
  .mwi-section-head h3 { margin: 0; font-weight: 500; }
  .mwi-head h2 { color: #d8c7ef; font-size: 1.28rem; }
  .mwi-section-head h3 { color: #cbb8e5; font-size: 1rem; }
  .mwi-kicker,
  .mwi-section-head span,
  .mwi-status {
    font: 0.68rem ui-monospace, "SF Mono", Menlo, monospace;
    letter-spacing: 0.06em;
    color: var(--mwi-dim);
  }
  .mwi-status {
    margin: 0;
    max-width: 55%;
    text-align: right;
  }
  .mwi-status[data-kind="refusal"] { color: #dc9b8e; }
  .mwi-axes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .mwi-axis {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mwi-axis > span {
    color: var(--mwi-dim);
    font: 0.68rem ui-monospace, "SF Mono", Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .mwi-chip,
  .mwi-small,
  .mwi-stake-launch,
  .mwi-action,
  .mwi-close {
    border: 1px solid var(--mwi-violet-dark);
    color: #cbb8e5;
    background: rgba(101, 81, 127, 0.12);
    cursor: pointer;
    font: 0.72rem ui-monospace, "SF Mono", Menlo, monospace;
  }
  .mwi-chip {
    border-radius: 999px;
    padding: 4px 9px;
  }
  .mwi-chip.on {
    color: #1b1720;
    background: var(--mwi-violet);
    border-color: var(--mwi-violet);
  }
  .mwi-law {
    margin: 8px 0 0;
    color: #bcb2a1;
    font-size: 0.82rem;
    font-style: italic;
  }
  .mwi-drafts,
  .mwi-portfolio,
  .mwi-door {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed var(--mwi-violet-dark);
  }
  .mwi-draft-card {
    margin-top: 9px;
    padding: 10px 12px;
    border: 1px dashed var(--mwi-violet);
    border-left: 4px double var(--mwi-violet);
    border-radius: 4px;
    background: repeating-linear-gradient(
      -45deg,
      rgba(120, 94, 151, 0.10),
      rgba(120, 94, 151, 0.10) 8px,
      rgba(20, 23, 29, 0.16) 8px,
      rgba(20, 23, 29, 0.16) 16px
    );
  }
  .mwi-draft-state {
    color: #cbb8e5;
    font: 0.67rem ui-monospace, "SF Mono", Menlo, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mwi-draft-body { margin: 6px 0; line-height: 1.42; }
  .mwi-draft-meta,
  .mwi-draft-card code {
    color: var(--mwi-dim);
    font: 0.68rem ui-monospace, "SF Mono", Menlo, monospace;
  }
  .mwi-draft-card code { display: block; margin-top: 4px; }
  .mwi-categories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 8px;
  }
  .mwi-categories details {
    min-width: 0;
    border: 1px solid var(--mwi-line);
    border-radius: 4px;
    background: rgba(20, 23, 29, 0.42);
  }
  .mwi-categories summary {
    padding: 7px 9px;
    color: #d4c7b6;
    cursor: pointer;
    font: 0.74rem ui-monospace, "SF Mono", Menlo, monospace;
  }
  .mwi-categories summary b {
    float: right;
    color: var(--mwi-violet);
  }
  .mwi-list {
    list-style: none;
    margin: 0;
    padding: 0 9px 9px;
  }
  .mwi-list li {
    padding: 7px 0;
    border-top: 1px dotted var(--mwi-line);
  }
  .mwi-list code,
  .mwi-list span {
    display: block;
    overflow-wrap: anywhere;
  }
  .mwi-list code { color: #d8c7ef; font-size: 0.7rem; }
  .mwi-list span { margin-top: 3px; color: var(--mwi-dim); font-size: 0.72rem; }
  .mwi-empty { margin: 5px 9px 10px; color: var(--mwi-dim); font-size: 0.75rem; font-style: italic; }
  .mwi-small {
    margin-top: 6px;
    border-radius: 999px;
    padding: 3px 7px;
  }
  .mwi-stake-launch {
    margin-left: auto;
    border-radius: 999px;
    padding: 2px 8px;
  }
  .mwi-stake-launch:hover,
  .mwi-small:hover,
  .mwi-action:hover { background: rgba(170, 143, 216, 0.2); }
  .mwi-legacy-hidden,
  .mwi-filtered-out { display: none !important; }
  .mwi-door {
    position: relative;
    border: 1px solid var(--mwi-violet-dark);
    border-radius: 5px;
    padding: 12px;
    background: rgba(14, 16, 21, 0.96);
  }
  .mwi-close {
    border: 0;
    background: transparent;
    font-size: 1.15rem;
  }
  .mwi-field {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 9px;
    align-items: center;
    margin-top: 9px;
  }
  .mwi-field > span {
    color: var(--mwi-dim);
    font: 0.7rem ui-monospace, "SF Mono", Menlo, monospace;
  }
  .mwi-field input,
  .mwi-field select {
    min-width: 0;
    border: 1px solid var(--mwi-line);
    border-radius: 3px;
    padding: 7px 8px;
    color: var(--mwi-ink);
    background: #111319;
    font: 0.76rem ui-monospace, "SF Mono", Menlo, monospace;
  }
  .mwi-action {
    margin-top: 10px;
    border-radius: 4px;
    padding: 7px 11px;
  }
  .mwi-action:disabled { cursor: not-allowed; opacity: 0.45; }
  .mwi-preview { margin-top: 12px; }
  .mwi-preview > span {
    color: var(--mwi-violet);
    font: 0.68rem ui-monospace, "SF Mono", Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .mwi-preview pre {
    margin: 6px 0;
    padding: 10px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    border: 1px solid var(--mwi-violet-dark);
    color: #eadff6;
    background: #0d0e12;
    font: 0.72rem ui-monospace, "SF Mono", Menlo, monospace;
  }
  .mwi-preview p {
    margin: 0;
    color: #bcb2a1;
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .mwi-preview b { color: #d8c7ef; }
  .mwi-confirm { border-color: var(--mwi-violet); color: #e6d7f6; }
  .mwi-answer {
    margin: 10px 0 0;
    padding: 8px 10px;
    border-left: 3px solid var(--mwi-dim);
    color: #cbc2b4;
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.78rem;
  }
  .mwi-answer[data-kind="success"] { border-color: #7bb58e; color: #a9d9b7; }
  .mwi-answer[data-kind="refusal"] { border-color: #c07869; color: #dc9b8e; }
  @media (max-width: 820px) {
    .mwi-categories { grid-template-columns: 1fr; }
    .mwi-status { max-width: none; text-align: left; }
    .mwi-head { align-items: flex-start; flex-direction: column; }
  }
</style>
