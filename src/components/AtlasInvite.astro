---
// AtlasInvite — the map behind a veil: blurred map under the section's words,
// one golden button that sends the reader to it.
//
// ── THE OVERLAY IS GONE (#2800, 2026-09-16) ─────────────────────────────────
//
// This component had two modes. With a `cta` it rendered a LINK; without one it
// rendered a button that opened `/atlas/town.html` in a full-viewport iframe.
// The atlas retired — the World replaced it on 2026-09-08 and /atlas/ now
// forwards to /world/ — and the atlas page was the only caller that omitted
// `cta`. So the overlay had exactly one consumer and that consumer is deleted;
// the iframe, its top bar, its wiring script and its styles went with it rather
// than staying as an unreachable embed of a retired page.
//
// The front door is the one caller left, and it always passed a `cta`, so what
// it renders is unchanged: the veil, the words, the button. `cta` is therefore
// required now instead of optional — a caller that forgets it gets a section
// with no way out, which is worth failing loudly on.
//
// The name and the `atlas` id stay. The id is an anchor target on the front
// door (`/#atlas`), and a live fragment is a URL someone may already hold.
const { id = "atlas", cta } = Astro.props;
if (!cta?.href || !cta?.label) {
  throw new Error("AtlasInvite: `cta` ({ href, label }) is required — the in-place atlas overlay retired with #2800.");
}
---
<section class="atlas-invite" id={id}>
  <img class="ai-bg" src="/thumbs/atlas.jpg" alt="" aria-hidden="true" />
  <div class="ai-veil"></div>
  <div class="ai-copy">
    <slot />
    <a class="pm-btn ai-open" href={cta.href}>{cta.label}</a>
  </div>
</section>

<style>
  .atlas-invite {
    position: relative;
    display: grid; place-items: center; text-align: center;
    min-height: 460px;
    margin: 0 0 2.8em;
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(232, 196, 139, 0.25);
  }
  .ai-bg {
    position: absolute; inset: -24px;
    width: calc(100% + 48px); height: calc(100% + 48px);
    object-fit: cover;
    filter: blur(11px) brightness(0.85);
  }
  .ai-veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(80% 80% at 50% 50%, rgba(13, 20, 38, 0.42), rgba(7, 11, 21, 0.78)),
      rgba(13, 20, 38, 0.35);
  }
  .ai-copy { position: relative; z-index: 2; max-width: 66ch; padding: 3em 1.5em; }
  .ai-copy :global(p) { color: #e2d7bd; font-size: clamp(0.98rem, 2vw, 1.06rem); }
  .ai-copy :global(p em) { color: var(--pm-gold); }
  .ai-copy :global(h1), .ai-copy :global(h2) {
    margin: 0 0 0.5em;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    color: var(--pm-gold-bright);
    text-shadow: 0 0 30px rgba(232, 196, 139, 0.25);
  }
  .ai-open { margin-top: 0.6em; font-size: 0.92rem; padding: 13px 30px; }
  /* The overlay's rules (.atlas-overlay, .ao-bar, .ao-title, .ao-close and the
     iframe) left with the overlay itself — see the header. */
</style>
